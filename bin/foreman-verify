#!/usr/bin/env python3
"""Front verification: the command that judges a front's work.

    foreman-verify <front> <check>

One front is implemented, `panel`, and two of its checks:

  --loads          the plugin's QML lints clean and its model layer folds
                   both fixtures (the mock and the live shape) into the
                   eight blocks of DESIGN section 13, run headlessly with
                   no Wayland display
  --blocks-count   how many of those eight blocks came back non-empty, as one
                   integer and nothing else
  --blocks         the panel headlessly rendered against the fixture: the
                   header numbers, and for each rendered block the number
                   of cards and the title text of each

`--keys` and `--install-roundtrip` belong to jobs that have not run yet
and exit 2.

Standard library only, so this runs wherever the repository is checked out.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PLUGIN = REPO / "plugin" / "foreman"
HARNESS = PLUGIN / "Harness.qml"
PANEL_HARNESS = PLUGIN / "PanelHarness.qml"
FIXTURE = PLUGIN / "test" / "fixture"
FIXTURE_LIVE = PLUGIN / "test" / "fixture-live"

#: Where Omarchy is installed. Read only, never written, never edited.
OMARCHY = Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"))

#: The eight blocks and the count each one must report against the fixture in
#: plugin/foreman/test/fixture. These are derived by hand from the fixture
#: files, never from a run of the parser under test:
#:
#:   header      10  observed.json swarm.sessions_registered; roster.json has
#:                   the same ten sessions
#:   needsYou     2  inbox.jsonl has 4 lines and 3 ids; inb-theme001 is
#:                   written twice and the later line answers it, leaving
#:                   inb-tokens01 and inb-reaper01 open
#:   problems     3  anomalies.jsonl has 5 lines and 4 (kind, subject) pairs;
#:                   the later "job stalled/ses-wcorp002" line resolves it,
#:                   leaving supervisor silent, intruder, defect repeated
#:   working      5  seven directories under fronts/; digest and dashboard are
#:                   state "queued", so corpus, api, engine, ingestion, reaper
#:   jobQueue     6  planned or queued jobs after folding: corpus job-cor-4,
#:                   api job-api-4 and job-api-5, engine job-eng-1, ingestion
#:                   job-ing-1, reaper job-rea-1. corpus job-cor-2 is written
#:                   planned and then running, and the later line wins
#:   frontQueue   2  digest and dashboard
#:   mergeQueue   5  merges.jsonl has 6 lines and 5 ids; mrg-labelidx is
#:                   written twice and the later line lands it
#:   capacity     4  observed.json pools: opus, codex, grok, muse
EXPECTED = {
    "header": 10,
    "needsYou": 2,
    "problems": 3,
    "working": 5,
    "jobQueue": 6,
    "frontQueue": 2,
    "mergeQueue": 5,
    "capacity": 4,
}

#: The eight blocks and the count each one must report against the
#: live-shape fixture in plugin/foreman/test/fixture-live. Hand-derived the
#: same way, never from a run of the parser under test. That fixture copies
#: what the runtime actually writes: observed.json has no `fronts` key,
#: doing-now lives in sessions/<id>/checkpoint.json, two jobs reference
#: their task by title, and the astra role waits on the codex pool:
#:
#:   header       3  observed.json swarm.sessions_registered; roster.json has
#:                   the same three sessions
#:   needsYou     2  inbox.jsonl has 3 lines and 3 ids; inb-hb003 is answered,
#:                   leaving inb-hb001 (asked by a worker, ses-hb0002) and
#:                   inb-hb002 open
#:   problems     1  anomalies.jsonl has 3 lines and 2 (kind, subject) pairs;
#:                   the later "job stalled/ses-hb0002" line resolves it,
#:                   leaving the intruder pid-5521
#:   working      1  two directories under fronts/; quay is state "queued",
#:                   so harbor alone
#:   jobQueue     2  planned or queued jobs after folding: harbor job-hb-3
#:                   (queued, task by id) and job-hb-4 (planned, task by
#:                   title "tide window"); job-hb-1 is verified and job-hb-2
#:                   is running
#:   frontQueue   1  quay
#:   mergeQueue   2  mrg-hb001 merging, mrg-hb002 landed
#:   capacity     2  observed.json pools: codex, muse
EXPECTED_LIVE = {
    "header": 3,
    "needsYou": 2,
    "problems": 1,
    "working": 1,
    "jobQueue": 2,
    "frontQueue": 1,
    "mergeQueue": 2,
    "capacity": 2,
}

#: Row-level facts the live-shape fixture must produce, hand-derived from
#: its bytes the same way. Each one names the break it catches — the old
#: model, written against the entity definitions, gets it wrong:
#:
#:   harbor.doingNow        the supervisor checkpoint's `doing`, not
#:                          observed.fronts (which the live fixture omits)
#:   harbor.remaining       the built task "buoy labels" stays listed:
#:                          section 13 wants every task not landed
#:   tas-hb-2.jobs          job-hb-2 references its task by title
#:                          ("second soundings"), not by id
#:   tas-hb-4.jobs          job-hb-3 by id plus job-hb-4 by title
#:                          ("tide window"), in ledger order
#:   codex.waiting          job-hb-3 waits as role astra on pool codex,
#:                          via the slots ledger mapping
#:   job-hb-N.model         projected from the roster row of the job's
#:                          session (hb-1, hb-2); no session attached yet:
#:                          honest "unknown" (hb-3, hb-4)
#:   harbor.blockedOnOwner  inb-hb001 asked by worker ses-hb0002, joined
#:                          through roster.front, in inbox order
#:   harbor.rateWindowH     oldest unlanded creation stamp 12:00 to the
#:                          15:00 collector clock: 3 hours. (A rewrite keeps
#:                          its task's creation `at`, as the runtime does for
#:                          tas-hb-2's second line, so the window is work age,
#:                          not a progress span.)
#:   harbor.ratePerHour     unlanded output so far, 8 + 6 + 0 = 14 units,
#:                          over that window: 14 / 3, read back as a float
#:   harbor.projectedFinish 7 units left at that rate from the 15:00
#:                          collector clock: 15:00 + 1:30 = 16:30 UTC
#:   quay.doingNow          no checkpoint and no observed.fronts: empty,
#:                          not an error
EXPECTED_LIVE_ROWS = {
    "front.harbor.doingNow": "Second soundings running, 8 of 12 read",
    "front.harbor.remaining": "second soundings|buoy labels|tide window",
    "task.harbor.tas-hb-1.jobs": "job-hb-1",
    "task.harbor.tas-hb-2.jobs": "job-hb-2",
    "task.harbor.tas-hb-4.jobs": "job-hb-3|job-hb-4",
    "capacity.codex.waiting": "1",
    "capacity.muse.waiting": "1",
    "job.job-hb-1.model": "muse",
    "job.job-hb-2.model": "muse",
    "job.job-hb-3.model": "unknown",
    "job.job-hb-4.model": "unknown",
    "front.harbor.blockedOnOwner":
        "Sound the north channel first or the south?"
        "|Buy one more night of survey boat time?",
    "front.harbor.rateWindowH": "3",
    "front.harbor.projectedFinish": "2026-06-02T16:30:00.000Z",
    "front.quay.doingNow": "",
}
#: The one row fact read back as a float rather than compared as text.
EXPECTED_LIVE_RATE = 14 / 3

#: What `panel --blocks` must read off the headless render against the
#: mock fixture in plugin/foreman/test/fixture. Hand-derived from the
#: fixture bytes, never from a run of the panel under test:
#:
#:   header      the header row left to right: the word foreman, the
#:               collector clock in UTC (observed.json `at`
#:               2026-05-11T14:07:00+00:00, a Monday), "10 sessions, all
#:               registered" (10 registered and 10 observed), "not
#:               frozen" (no `frozen` file), and the collector state.
#:               The collector age is measured against the wall clock,
#:               so the May fixture always reads stale, where the mock
#:               shows alive.
#:   needsYou    inbox.jsonl sorted by asked_at, answered rows dropped:
#:               inb-tokens01 then inb-reaper01 (inb-theme001 is answered
#:               by the later line)
#:   problems    anomalies.jsonl in ledger order, resolved rows dropped:
#:               supervisor silent, intruder, defect repeated (the "job
#:               stalled" pair is resolved by the later line); the title
#:               on screen is each row's detail sentence
EXPECTED_PANEL_HEADER = [
    "foreman",
    "Monday 14:07",
    "10 sessions, all registered",
    "not frozen",
    "collector stale",
]
EXPECTED_PANEL_NEEDSYOU = [
    "Buy 2M extra Codex tokens so the review pool keeps two reviewers overnight?",
    "Ship the reaper without the dead-worktree sweep?",
]
EXPECTED_PANEL_PROBLEMS = [
    "Engine supervisor has been silent for 14 minutes with no jobs running,"
    " still holding an Opus slot",
    "A Codex process is running that Foreman did not launch:"
    " workspace 9, no session id",
    "Ingestion is halted: the webhook destination defect came back a third"
    " time, the supervisor must write what changed before dispatching again",
]

#: The Working block against the mock fixture, in the model's order (the
#: front directories sort alphabetically, so api comes before corpus).
#: One card per working front plus the merge desk card; each entry is the
#: card title, its tone, its task-row count, and its monitors line.
#: Hand-derived from the fixture bytes: tones from the front condition
#: (moving / stalled-supervisor / halted / idle), task counts from
#: tasks.jsonl (every task gets a row; fronts with nothing running show
#: the muted sentence instead, so zero rows), monitors from
#: measurements.jsonl (last line per monitor, in first-seen order).
EXPECTED_PANEL_WORKING = [
    ("api", "green", 6,
     "metrics: routes served from the ledger 11/14 · schema drift 0"),
    ("corpus", "green", 7,
     "metrics: apps collected 412/600 · labels double-read 184/600"
     " · label agreement 0.91"),
    ("engine", "red", 0,
     "metrics: slots returned after a restart 0/4"),
    ("ingestion", "red", 0,
     "metrics: duplicate landings 3"),
    ("reaper", "dim", 0,
     "metrics: processes left behind 0"),
    ("merge desk", "plain", 0, ""),
]

#: The slots the panel renders, in Panel.qml's order. needsYou and
#: problems arrived with the shell job; the rest land with the other
#: layout jobs and are reported, not asserted, until they do.
PANEL_SLOTS = ["needsYou", "problems", "working", "jobQueue",
               "frontQueue", "mergeQueue", "capacity"]

BLOCKS = list(EXPECTED)

ANSI = re.compile(r"\x1b\[[0-9;]*m")

#: The plugin's surfaces import qs.Commons, which only resolves inside the
#: Omarchy shell's own config root. Running the model on its own leaves that
#: import dangling, and Quickshell says so. Every other unresolvable import is
#: a real failure.
EXPECTED_DANGLING_IMPORT = "/Commons"

#: qmllint reports everything as a warning with a category in brackets, so the
#: category is what decides. These fail the check: the file does not parse, an
#: import does not resolve, a type does not exist. The categories left out are
#: the ones qmllint also raises against Omarchy's own shipped plugins:
#: `missing-property`, because it cannot see through the shell's nested token
#: objects, and `uncreatable-type`, which it says about every PanelWindow.
FATAL_CATEGORIES = ("[syntax]", "[import]", "[unresolved-type]",
                    "[missing-type]", "[incompatible-type]",
                    "[invalid-lint-directive]")


class Failure(Exception):
    """A named check that did not pass."""


def _clean(text: str) -> str:
    return ANSI.sub("", text)


def find_qmllint() -> str:
    """qmllint ships with qt6-declarative but is not on PATH on this machine."""
    for candidate in ("qmllint", "qmllint6"):
        found = shutil.which(candidate)
        if found:
            return found
    for candidate in ("/usr/lib/qt6/bin/qmllint", "/usr/lib/qt6/bin/qmllint6"):
        if Path(candidate).is_file():
            return candidate
    raise Failure("qmllint: not found on PATH or under /usr/lib/qt6/bin")


def find_quickshell() -> str:
    for candidate in ("qs", "quickshell"):
        found = shutil.which(candidate)
        if found:
            return found
    raise Failure("quickshell: neither `qs` nor `quickshell` is on PATH")


def headless_env(state_dir: Path) -> dict:
    """No Wayland display, no GPU, no theme plugin, and the fixture as the
    only state directory the model can see."""
    env = dict(os.environ)
    env.pop("WAYLAND_DISPLAY", None)
    env.pop("DISPLAY", None)
    env["QT_QPA_PLATFORM"] = "offscreen"
    env["QT_QPA_PLATFORMTHEME"] = ""
    env["FOREMAN_STATE"] = str(state_dir)
    return env


def check_lint() -> list[str]:
    """Every QML file in the plugin, linted. An error or an import that does
    not resolve fails; the property warnings qmllint raises against the
    shell's nested token objects do not, because it raises the same ones
    against Omarchy's own shipped plugins."""
    qmllint = find_qmllint()
    files = sorted(str(path) for path in PLUGIN.rglob("*.qml"))
    if not files:
        raise Failure("qmllint: no QML files found under " + str(PLUGIN))

    # qs.Commons is declared by /usr/share/omarchy/shell/Commons/qmldir as a
    # module named qs.Commons, so it resolves under an import path holding a
    # `qs` entry that points at the shell.
    imports = REPO / ".foreman-verify-imports"
    imports.mkdir(exist_ok=True)
    link = imports / "qs"
    shell = OMARCHY / "shell"
    try:
        if link.is_symlink() or link.exists():
            link.unlink()
        if shell.is_dir():
            link.symlink_to(shell)

        result = subprocess.run(
            [qmllint, "-I", str(imports), *files],
            capture_output=True, text=True, timeout=180)
    finally:
        if link.is_symlink():
            link.unlink()
        try:
            imports.rmdir()
        except OSError:
            pass

    output = _clean(result.stdout + result.stderr)
    problems = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("Error:"):
            problems.append(stripped)
            continue
        fatal = any(category in stripped for category in FATAL_CATEGORIES)
        if fatal or "is not installed" in stripped:
            if EXPECTED_DANGLING_IMPORT not in stripped:
                problems.append(stripped)
    if problems:
        raise Failure("qmllint: " + str(len(problems)) + " problem(s):\n  "
                      + "\n  ".join(problems))
    return files


def run_harness(state_dir: Path) -> dict:
    """The model layer with no window on it, against `state_dir`.

    Quickshell exits 0 on a configuration that failed to load, so the pass or
    fail decision is made from the output, never from the status."""
    quickshell = find_quickshell()
    if not HARNESS.is_file():
        raise Failure("harness: missing " + str(HARNESS))
    if not state_dir.is_dir():
        raise Failure("harness: no such state directory: " + str(state_dir))

    result = subprocess.run(
        [quickshell, "-p", str(HARNESS)],
        capture_output=True, text=True, timeout=120,
        env=headless_env(state_dir))
    output = _clean(result.stdout + result.stderr)

    trouble = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("ERROR"):
            # Host-runtime noise, never the model layer: quickshell failing
            # to create its /run directory or bind its IPC socket (as in a
            # sandbox without AF_UNIX) says nothing about the panel.
            if re.match(r"ERROR quickshell\.(paths|ipc|logging|tooling):",
                        stripped):
                continue
            trouble.append(stripped)
        elif "unresolvable import" in stripped:
            if EXPECTED_DANGLING_IMPORT not in stripped:
                trouble.append(stripped)
        elif "TypeError" in stripped or "ReferenceError" in stripped:
            trouble.append(stripped)
    if trouble:
        raise Failure("harness: the model layer reported errors:\n  "
                      + "\n  ".join(trouble[:10]))

    counts = {}
    details = {}
    nonempty = None
    for line in output.splitlines():
        cleaned = _clean(line)
        match = re.search(r"BLOCK ([A-Za-z]+) (-?\d+)\s*$", cleaned)
        if match:
            counts[match.group(1)] = int(match.group(2))
            continue
        match = re.search(r"DETAIL (\S+?)(?: (.*))?\s*$", cleaned)
        if match:
            details[match.group(1)] = match.group(2) or ""
            continue
        match = re.search(r"NONEMPTY (-?\d+)\s*$", cleaned)
        if match:
            nonempty = int(match.group(1))
    if "HARNESS-DONE" not in output:
        raise Failure("harness: did not finish; output was:\n" + output[-2000:])
    if nonempty is None:
        raise Failure("harness: printed no NONEMPTY line")
    return {"counts": counts, "details": details, "nonempty": nonempty}


def check_blocks(state_dir: Path, expected: dict, label: str) -> dict:
    result = run_harness(state_dir)
    counts = result["counts"]
    missing = [name for name in BLOCKS if name not in counts]
    if missing:
        raise Failure("blocks (%s): the model never reported %s"
                      % (label, ", ".join(missing)))
    wrong = ["%s: got %d, the fixture holds %d"
             % (name, counts[name], expected[name])
             for name in BLOCKS if counts[name] != expected[name]]
    if wrong:
        raise Failure("blocks (%s): %d count(s) wrong:\n  %s"
                      % (label, len(wrong), "\n  ".join(wrong)))
    return result


def check_live_rows(details: dict) -> None:
    """The live-shape rows each fix owns, against hand-derived literals."""
    missing = [key for key in EXPECTED_LIVE_ROWS if key not in details]
    if missing:
        raise Failure("rows (live-shape): the model never reported "
                      + ", ".join(missing))
    if "front.harbor.ratePerHour" not in details:
        raise Failure("rows (live-shape): the model never reported "
                      "front.harbor.ratePerHour")
    wrong = ["%s: got %r, the fixture holds %r"
             % (key, details[key], EXPECTED_LIVE_ROWS[key])
             for key in EXPECTED_LIVE_ROWS
             if details[key] != EXPECTED_LIVE_ROWS[key]]
    try:
        rate = float(details["front.harbor.ratePerHour"])
    except ValueError:
        raise Failure("rows (live-shape): front.harbor.ratePerHour: got %r, "
                      "the fixture holds %r"
                      % (details["front.harbor.ratePerHour"],
                         EXPECTED_LIVE_RATE))
    if abs(rate - EXPECTED_LIVE_RATE) > 1e-9:
        wrong.append("front.harbor.ratePerHour: got %r, the fixture holds %r"
                     % (details["front.harbor.ratePerHour"],
                        EXPECTED_LIVE_RATE))
    if wrong:
        raise Failure("rows (live-shape): %d row(s) wrong:\n  %s"
                      % (len(wrong), "\n  ".join(wrong)))


def loads(state_dir: Path) -> int:
    files = check_lint()
    print("qmllint: %d QML file(s) clean" % len(files))
    # Both fixtures, each against its own hand-derived counts: the mock
    # proves the fixture renders, the live shape proves the runtime's real
    # output does. An explicit --state replaces the mock fixture only; the
    # live shape is always checked at its own path.
    mock = check_blocks(state_dir, EXPECTED, "mock")
    for name in BLOCKS:
        print("mock %s %d" % (name, mock["counts"][name]))
    live = check_blocks(FIXTURE_LIVE, EXPECTED_LIVE, "live-shape")
    for name in BLOCKS:
        print("live %s %d" % (name, live["counts"][name]))
    check_live_rows(live["details"])
    print("live rows: %d row fact(s) as the fixture holds them"
          % (len(EXPECTED_LIVE_ROWS) + 1))
    print("loads: the plugin lints and its model folds both fixtures "
          "into all eight blocks")
    return 0


def blocks_count(state_dir: Path) -> int:
    print(run_harness(state_dir)["nonempty"])
    return 0


def run_panel_harness(state_dir: Path) -> dict:
    """The panel's header and blocks with a window on them, against
    `state_dir`.

    The panel binds qs.Commons, which only resolves inside the Omarchy
    shell's own config root, so the run gets a QML import path holding a
    `qs` entry that points at the shell — the same arrangement check_lint
    uses. Pass or fail comes from the output, never from the status."""
    quickshell = find_quickshell()
    if not PANEL_HARNESS.is_file():
        raise Failure("harness: missing " + str(PANEL_HARNESS))
    if not state_dir.is_dir():
        raise Failure("harness: no such state directory: " + str(state_dir))

    imports = REPO / ".foreman-verify-imports"
    imports.mkdir(exist_ok=True)
    link = imports / "qs"
    shell = OMARCHY / "shell"
    try:
        if link.is_symlink() or link.exists():
            link.unlink()
        if shell.is_dir():
            link.symlink_to(shell)

        env = headless_env(state_dir)
        existing = env.get("QML2_IMPORT_PATH", "")
        env["QML2_IMPORT_PATH"] = (str(imports) + (os.pathsep + existing
                                                   if existing else ""))
        result = subprocess.run(
            [quickshell, "-p", str(PANEL_HARNESS)],
            capture_output=True, text=True, timeout=120,
            env=env)
    finally:
        if link.is_symlink():
            link.unlink()
        try:
            imports.rmdir()
        except OSError:
            pass

    output = _clean(result.stdout + result.stderr)

    trouble = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("ERROR"):
            if re.match(r"ERROR quickshell\.(paths|ipc|logging|tooling):",
                        stripped):
                continue
            trouble.append(stripped)
        elif "unresolvable import" in stripped:
            # The static scanner does not see the runtime qs -> shell
            # mapping, so it warns about qs.Commons while the engine
            # resolves it. Any other unresolvable import is a real failure.
            if EXPECTED_DANGLING_IMPORT not in stripped:
                trouble.append(stripped)
        elif "TypeError" in stripped or "ReferenceError" in stripped:
            trouble.append(stripped)
        elif stripped.startswith("SLOT-ERROR"):
            trouble.append("harness: " + stripped)
    if trouble:
        raise Failure("panel harness: the render reported errors:\n  "
                      + "\n  ".join(trouble[:10]))

    counts: dict = {}
    renders: dict = {}
    for line in output.splitlines():
        cleaned = _clean(line)
        match = re.search(r"BLOCK ([A-Za-z]+) (-?\d+)\s*$", cleaned)
        if match:
            counts[match.group(1)] = int(match.group(2))
            continue
        match = re.search(r"RENDER (\S+) (\S+) (\d+) (\{.*\})\s*$", cleaned)
        if match:
            try:
                shown = json.loads(match.group(4))
                titles = shown["titles"]
                empty = shown["empty"]
            except (ValueError, KeyError, TypeError):
                raise Failure("panel harness: unparsable render: %r"
                              % match.group(4))
            renders[match.group(1)] = {
                "status": match.group(2),
                "cards": int(match.group(3)),
                "titles": titles,
                "empty": empty,
                "details": shown.get("details", []),
            }
    if "HARNESS-DONE" not in output:
        raise Failure("panel harness: did not finish; output was:\n"
                      + output[-2000:])
    return {"counts": counts, "renders": renders}


def panel_blocks(state_dir: Path) -> int:
    """Header numbers and, for each block of this job's scope, the card
    count and title text of every card, read off the headless render.
    Slots whose files have not landed yet are reported, never asserted,
    so this stays meaningful as the other layout jobs arrive. The strict
    assertions hold the mock fixture; an explicit --state only reports
    what the render shows."""
    result = run_panel_harness(state_dir)
    renders = result["renders"]

    missing = [name for name in ["header", *PANEL_SLOTS]
               if name not in renders]
    if missing:
        raise Failure("blocks: the panel never rendered %s"
                      % ", ".join(missing))
    broken = ["%s (%s)" % (name, renders[name]["status"])
              for name in renders if renders[name]["status"] == "error"]
    if broken:
        raise Failure("blocks: %d block file(s) failed to load:\n  %s"
                      % (len(broken), "\n  ".join(broken)))

    strict = state_dir.resolve() == FIXTURE.resolve()
    if strict:
        check_panel_strict(renders)

    header = renders["header"]
    print("header: %s" % " · ".join(header["titles"]))
    for name in PANEL_SLOTS:
        slot = renders[name]
        if slot["status"] != "ready":
            print("%s: not yet rendered (%s)" % (name, slot["status"]))
            continue
        print("%s: %d card(s)" % (name, slot["cards"]))
        for title in slot["titles"]:
            print("  %s" % title)
        for voice in slot["empty"]:
            print("  empty: %s" % voice)
    if strict:
        print("blocks: the header and this job's blocks render as the"
              " fixture holds them")
    else:
        print("blocks: reported without assertions (not the mock fixture)")
    return 0


def check_panel_strict(renders: dict) -> None:
    """The mock-fixture assertions: header numbers, and for each block of
    this job's scope the card count, every title, and a silent empty
    voice."""
    header = renders["header"]
    if header["titles"] != EXPECTED_PANEL_HEADER:
        raise Failure("blocks: header: got %r, the fixture holds %r"
                      % (header["titles"], EXPECTED_PANEL_HEADER))

    for name, expected in (("needsYou", EXPECTED_PANEL_NEEDSYOU),
                           ("problems", EXPECTED_PANEL_PROBLEMS)):
        slot = renders[name]
        if slot["status"] != "ready":
            raise Failure("blocks: %s: not rendered (%s)"
                          % (name, slot["status"]))
        if slot["cards"] != len(expected) or slot["titles"] != expected:
            raise Failure("blocks: %s: got %d card(s) %r, the fixture holds"
                          " %d with %r"
                          % (name, slot["cards"], slot["titles"],
                             len(expected), expected))
        if slot["empty"]:
            raise Failure("blocks: %s: empty voice shows beside %d card(s)"
                          % (name, slot["cards"]))

    slot = renders["working"]
    if slot["status"] != "ready":
        raise Failure("blocks: working: not rendered (%s)" % slot["status"])
    expected_titles = [title for title, _, _, _ in EXPECTED_PANEL_WORKING]
    if slot["cards"] != len(expected_titles) or slot["titles"] != expected_titles:
        raise Failure("blocks: working: got %d card(s) %r, the fixture holds"
                      " %d with %r"
                      % (slot["cards"], slot["titles"],
                         len(expected_titles), expected_titles))
    if slot["empty"]:
        raise Failure("blocks: working: empty voice shows beside %d card(s)"
                      % slot["cards"])
    details = slot.get("details", [])
    got = [(card.get("title", ""), card.get("tone", ""),
            card.get("tasks", -1), card.get("monitors", ""))
           for card in details]
    if got != EXPECTED_PANEL_WORKING:
        raise Failure("blocks: working: got %r, the fixture holds %r"
                      % (got, EXPECTED_PANEL_WORKING))


NOT_IMPLEMENTED = {
    "--keys": "the keys and actions job has not run yet",
    "--install-roundtrip": "the install/uninstall job has not run yet",
}


def main(argv: list[str]) -> int:
    # The check is spelled as a flag (`panel --loads`), so it is pulled out of
    # argv before argparse sees it and treats it as an option of its own.
    parser = argparse.ArgumentParser(
        prog="foreman-verify",
        usage="foreman-verify <front> <check> [--state DIR]",
        description="Verify one front's work, one check at a time.")
    parser.add_argument("front", help="the front to verify (panel)")
    parser.add_argument("--state", default=str(FIXTURE),
                        help="state directory to read (default: the fixture)")

    known = set(NOT_IMPLEMENTED) | {"--loads", "--blocks-count", "--blocks"}
    rest, check = [], None
    for token in argv:
        if token in known and check is None:
            check = token
        else:
            rest.append(token)
    if check is None:
        parser.print_usage(sys.stderr)
        print("foreman-verify: no check named; one of "
              + ", ".join(sorted(known)), file=sys.stderr)
        return 2
    args = parser.parse_args(rest)
    args.check = check

    if args.front != "panel":
        print("foreman-verify: not implemented yet: front %r" % args.front,
              file=sys.stderr)
        return 2
    if args.check in NOT_IMPLEMENTED:
        print("foreman-verify: not implemented yet: %s (%s)"
              % (args.check, NOT_IMPLEMENTED[args.check]), file=sys.stderr)
        return 2

    checks = {"--loads": loads, "--blocks-count": blocks_count,
              "--blocks": panel_blocks}
    if args.check not in checks:
        print("foreman-verify: unknown check %r for front panel" % args.check,
              file=sys.stderr)
        return 2

    try:
        return checks[args.check](Path(args.state).expanduser())
    except Failure as failure:
        print("foreman-verify panel %s FAILED\n%s" % (args.check, failure),
              file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired as expired:
        print("foreman-verify panel %s FAILED\ntimed out running %s"
              % (args.check, expired.cmd), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
