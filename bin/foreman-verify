#!/usr/bin/env python3
"""Front verification: the command that judges a front's work.

    foreman-verify <front> <check>

One front is implemented, `panel`, and two of its checks:

  --loads          the plugin's QML lints clean and its model layer folds
                   both fixtures (the mock and the live shape) into the
                   eight blocks of DESIGN section 13, run headlessly with
                   no Wayland display
  --blocks-count   how many of those eight blocks came back non-empty, as one
                   integer and nothing else
  --blocks         the panel headlessly rendered against the fixture: the
                   header numbers, and for each rendered block the number
                   of cards and the title text of each

`--stall` runs a 100 ms timer beside a live model and reports every gap\nover 50 ms, with the block counts at each end so an empty model cannot\npass as a fast one; FOREMAN_PROBE_MS sets how long it watches.\n\n`--keys` drives every key against a throwaway copy of the fixture and
asserts the ledger line; `--install-roundtrip` runs the root `install`
and `uninstall` against temporary homes and asserts the round trip is
byte-exact.

Standard library only, so this runs wherever the repository is checked out.
"""

from __future__ import annotations

import argparse
import atexit
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

