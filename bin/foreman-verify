#: The slots the panel renders, in Panel.qml's order. needsYou and
#: problems arrived with the shell job; the rest land with the other
#: layout jobs and are reported, not asserted, until they do.
PANEL_SLOTS = ["needsYou", "problems", "working", "jobQueue",
               "frontQueue", "mergeQueue", "capacity"]

BLOCKS = list(EXPECTED)

ANSI = re.compile(r"\x1b\[[0-9;]*m")

#: The plugin's surfaces import qs.Commons, which only resolves inside the
#: Omarchy shell's own config root. Running the model on its own leaves that
#: import dangling, and Quickshell says so. Every other unresolvable import is
#: a real failure.
EXPECTED_DANGLING_IMPORT = "/Commons"

#: qmllint reports everything as a warning with a category in brackets, so the
#: category is what decides. These fail the check: the file does not parse, an
#: import does not resolve, a type does not exist. The categories left out are
#: the ones qmllint also raises against Omarchy's own shipped plugins:
#: `missing-property`, because it cannot see through the shell's nested token
#: objects, and `uncreatable-type`, which it says about every PanelWindow.
FATAL_CATEGORIES = ("[syntax]", "[import]", "[unresolved-type]",
                    "[missing-type]", "[incompatible-type]",
                    "[invalid-lint-directive]")


class Failure(Exception):
    """A named check that did not pass."""


def _clean(text: str) -> str:
    return ANSI.sub("", text)


def find_qmllint() -> str:
    """qmllint ships with qt6-declarative but is not on PATH on this machine."""
    for candidate in ("qmllint", "qmllint6"):
        found = shutil.which(candidate)
        if found:
            return found
    for candidate in ("/usr/lib/qt6/bin/qmllint", "/usr/lib/qt6/bin/qmllint6"):
        if Path(candidate).is_file():
            return candidate
    raise Failure("qmllint: not found on PATH or under /usr/lib/qt6/bin")


def find_quickshell() -> str:
    for candidate in ("qs", "quickshell"):
        found = shutil.which(candidate)
        if found:
            return found
    raise Failure("quickshell: neither `qs` nor `quickshell` is on PATH")


def headless_env(state_dir: Path) -> dict:
    """No Wayland display, no GPU, no theme plugin, and the fixture as the
    only state directory the model can see. Ambient FOREMAN_SESSION,
    FOREMAN_STATE and FOREMAN_CONFIG are never inherited: the harness
    names the world and the caller itself, rather than whoever holds
    the terminal. FOREMAN_CONFIG points at a path the fixture does not
    create, so a freeze during --keys cannot fire the owner's hooks."""
    env = dict(os.environ)
    env.pop("WAYLAND_DISPLAY", None)
    env.pop("DISPLAY", None)
    env.pop("FOREMAN_SESSION", None)
    env.pop("FOREMAN_STATE", None)
    env.pop("FOREMAN_CONFIG", None)
    env["QT_QPA_PLATFORM"] = "offscreen"
    env["QT_QPA_PLATFORMTHEME"] = ""
    env["FOREMAN_STATE"] = str(state_dir)
    env["FOREMAN_CONFIG"] = str(state_dir / "harness-config")
    env["PATH"] = str(repo_foreman()) + os.pathsep + env.get("PATH", "")
    return env


#: The `foreman` every headless run resolves is this repository's, never
#: whatever happens to be installed: the panel's keys run real verbs, and a
#: check that judged the installed build would pass or fail on code that is
#: not under review. The shim lives in a temporary directory for the life of
#: the process and is put on PATH ahead of everything else.
_SHIM: Path | None = None


def repo_foreman() -> Path:
    """A directory holding a `foreman` that runs this repository's source."""
    global _SHIM
    if _SHIM is not None:
        return _SHIM
    shim_dir = Path(tempfile.mkdtemp(prefix="foreman-verify-bin-"))
    atexit.register(shutil.rmtree, str(shim_dir), True)
    shim = shim_dir / "foreman"
    shim.write_text(
        "#!/bin/sh\n"
        'PYTHONPATH="%s${PYTHONPATH:+:$PYTHONPATH}"\n'
        "export PYTHONPATH\n"
        'exec "%s" -m foreman "$@"\n' % (REPO / "src", sys.executable))
    shim.chmod(0o755)
    _SHIM = shim_dir
    return shim_dir


def fold_panel(state_dir: Path) -> Path:
    """Write panel.json into `state_dir` with the verb under test.

    The panel reads that one file and no ledger, so every check feeds it the
    same way the runtime does: the repository's own `foreman panel-feed`,
    against the fixture state, with no ambient identity or world inherited.
    """
    env = dict(os.environ)
    for name in ("FOREMAN_SESSION", "FOREMAN_STATE", "FOREMAN_CONFIG"):
        env.pop(name, None)
    env["PYTHONPATH"] = str(REPO / "src") + (
        os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    result = subprocess.run(
        [sys.executable, "-m", "foreman", "panel-feed",
         "--fixture", str(state_dir)],
        capture_output=True, text=True, timeout=120, env=env)
    if result.returncode != 0 or not (state_dir / "panel.json").is_file():
        raise Failure("panel-feed: no panel.json for %s (exit %d)\n%s"
                      % (state_dir, result.returncode,
                         _clean(result.stdout + result.stderr)[-2000:]))
    return state_dir


def fed(state_dir: Path) -> Path:
    """A throwaway copy of `state_dir` with panel.json folded into it.

    The fixtures are read-only source: the summary the runtime writes is
    derived, so it is written beside a copy and thrown away with it rather
    than left in the tree.
    """
    if not state_dir.is_dir():
        raise Failure("harness: no such state directory: " + str(state_dir))
    tmp = Path(tempfile.mkdtemp(prefix="foreman-fed-"))
    atexit.register(shutil.rmtree, str(tmp), True)
    shutil.copytree(state_dir, tmp, dirs_exist_ok=True)
    return fold_panel(tmp)


def check_lint() -> list[str]:
    """Every QML file in the plugin, linted. An error or an import that does
    not resolve fails; the property warnings qmllint raises against the
    shell's nested token objects do not, because it raises the same ones
    against Omarchy's own shipped plugins."""
    qmllint = find_qmllint()
    files = sorted(str(path) for path in PLUGIN.rglob("*.qml"))
    if not files:
        raise Failure("qmllint: no QML files found under " + str(PLUGIN))

    # qs.Commons is declared by /usr/share/omarchy/shell/Commons/qmldir as a
    # module named qs.Commons, so it resolves under an import path holding a
    # `qs` entry that points at the shell.
    imports = REPO / ".foreman-verify-imports"
    imports.mkdir(exist_ok=True)
    link = imports / "qs"
    shell = OMARCHY / "shell"
    try:
        if link.is_symlink() or link.exists():
            link.unlink()
        if shell.is_dir():
            link.symlink_to(shell)

        result = subprocess.run(
            [qmllint, "-I", str(imports), *files],
            capture_output=True, text=True, timeout=180)
    finally:
        if link.is_symlink():
            link.unlink()
        try:
            imports.rmdir()
        except OSError:
            pass

    output = _clean(result.stdout + result.stderr)
    problems = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("Error:"):
            problems.append(stripped)
            continue
        fatal = any(category in stripped for category in FATAL_CATEGORIES)
        if fatal or "is not installed" in stripped:
            if EXPECTED_DANGLING_IMPORT not in stripped:
                problems.append(stripped)
    if problems:
        raise Failure("qmllint: " + str(len(problems)) + " problem(s):\n  "
                      + "\n  ".join(problems))
    return files


#: Quickshell crashes intermittently at startup in headless sandboxes
#: (SIGSEGV inside Qt's own startup code, before any QML runs: about one
#: run in three here, confirmed by coredump backtrace), so a run that dies
#: before reporting is retried. A run that reports is judged on its output
#: exactly once, and a failure that persists across every attempt still
#: fails: retries never turn a broken model into a pass, they only outlast
#: a dying runner.
HARNESS_ATTEMPTS = 3


def run_quickshell(args: list[str], env: dict) -> str:
    """Run quickshell until it reports (HARNESS-DONE in the output) or the
    attempts run out. Returns the last run's cleaned output; a run that
    times out is retried, and the final timeout propagates."""
    output = ""
    for attempt in range(HARNESS_ATTEMPTS):
        try:
            result = subprocess.run(
                args, capture_output=True, text=True, timeout=120, env=env)
        except subprocess.TimeoutExpired:
            if attempt == HARNESS_ATTEMPTS - 1:
                raise
            continue
        output = _clean(result.stdout + result.stderr)
        if "HARNESS-DONE" in output:
            return output
    return output


def run_harness(state_dir: Path) -> dict:
    """The model layer with no window on it, against `state_dir`.

    Quickshell exits 0 on a configuration that failed to load, so the pass or
    fail decision is made from the output, never from the status."""
    quickshell = find_quickshell()
    if not HARNESS.is_file():
        raise Failure("harness: missing " + str(HARNESS))
    if not state_dir.is_dir():
        raise Failure("harness: no such state directory: " + str(state_dir))

    output = run_quickshell(
        [quickshell, "-p", str(HARNESS)], headless_env(state_dir))

    trouble = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("ERROR"):
            # Host-runtime noise, never the model layer: quickshell failing
            # to create its /run directory or bind its IPC socket (as in a
            # sandbox without AF_UNIX) says nothing about the panel.
            if re.match(r"ERROR quickshell\.(paths|ipc|logging|tooling):",
                        stripped):
                continue
            trouble.append(stripped)
        elif "unresolvable import" in stripped:
            if EXPECTED_DANGLING_IMPORT not in stripped:
                trouble.append(stripped)
        elif "TypeError" in stripped or "ReferenceError" in stripped:
            trouble.append(stripped)
    if trouble:
        raise Failure("harness: the model layer reported errors:\n  "
                      + "\n  ".join(trouble[:10]))

    counts = {}
    details = {}
    nonempty = None
    for line in output.splitlines():
        cleaned = _clean(line)
        match = re.search(r"BLOCK ([A-Za-z]+) (-?\d+)\s*$", cleaned)
        if match:
            counts[match.group(1)] = int(match.group(2))
            continue
        match = re.search(r"DETAIL (\S+?)(?: (.*))?\s*$", cleaned)
        if match:
            details[match.group(1)] = match.group(2) or ""
            continue
        match = re.search(r"NONEMPTY (-?\d+)\s*$", cleaned)
        if match:
            nonempty = int(match.group(1))
    if "HARNESS-DONE" not in output:
        raise Failure("harness: did not finish; output was:\n" + output[-2000:])
    if nonempty is None:
        raise Failure("harness: printed no NONEMPTY line")
    return {"counts": counts, "details": details, "nonempty": nonempty}


def check_blocks(state_dir: Path, expected: dict, label: str) -> dict:
    result = run_harness(state_dir)
    counts = result["counts"]
    missing = [name for name in BLOCKS if name not in counts]
    if missing:
        raise Failure("blocks (%s): the model never reported %s"
                      % (label, ", ".join(missing)))
    wrong = ["%s: got %d, the fixture holds %d"
             % (name, counts[name], expected[name])
             for name in BLOCKS if counts[name] != expected[name]]
    if wrong:
        raise Failure("blocks (%s): %d count(s) wrong:\n  %s"
                      % (label, len(wrong), "\n  ".join(wrong)))
    return result


def check_live_rows(details: dict) -> None:
    """The live-shape rows each fix owns, against hand-derived literals."""
    missing = [key for key in EXPECTED_LIVE_ROWS if key not in details]
    if missing:
        raise Failure("rows (live-shape): the model never reported "
                      + ", ".join(missing))
    if "front.harbor.ratePerHour" not in details:
        raise Failure("rows (live-shape): the model never reported "
                      "front.harbor.ratePerHour")
    wrong = ["%s: got %r, the fixture holds %r"
             % (key, details[key], EXPECTED_LIVE_ROWS[key])
             for key in EXPECTED_LIVE_ROWS
             if details[key] != EXPECTED_LIVE_ROWS[key]]
    try:
        rate = float(details["front.harbor.ratePerHour"])
    except ValueError:
        raise Failure("rows (live-shape): front.harbor.ratePerHour: got %r, "
                      "the fixture holds %r"
                      % (details["front.harbor.ratePerHour"],
                         EXPECTED_LIVE_RATE))
    if abs(rate - EXPECTED_LIVE_RATE) > 1e-9:
        wrong.append("front.harbor.ratePerHour: got %r, the fixture holds %r"
                     % (details["front.harbor.ratePerHour"],
                        EXPECTED_LIVE_RATE))
    if wrong:
        raise Failure("rows (live-shape): %d row(s) wrong:\n  %s"
                      % (len(wrong), "\n  ".join(wrong)))


def _wall_age_s(iso: str) -> float:
    """Seconds from `iso` to now. The same question the panel's clock asks."""
    moment = datetime.fromisoformat(iso)
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)
    return (datetime.now(timezone.utc) - moment).total_seconds()


def _age_key(key: str) -> bool:
    return any(key.endswith(suffix) for suffix in AGE_KEY_SUFFIXES)


def _parse_age(value: str):
    """A harness age: a number, or one of the empty forms QML prints."""
    if value in ("", "null", "undefined"):
        return None
    try:
        return float(value)
    except ValueError:
        raise Failure("ages (live-shape): not a number: %r" % value)


def check_ages(details: dict) -> None:
    """Every age the harness prints is non-negative, lastTurnS is the
    wall-clock age of a stamp after observed.at, and collector freshness
    still ages observed.at.

    The break it catches: Model.now was observed.at, so a turn written
    between ticks rendered negative. Clamping to 0 without switching
    clocks also fails: lastTurnS would be 0, not months.
    """
    missing = [key for key in ("front.harbor.lastTurnS",
                               "front.harbor.wakeAgeS",
                               "header.collectorAt",
                               "header.collectorAgeS")
               if key not in details]
    if missing:
        raise Failure("ages (live-shape): the model never reported "
                      + ", ".join(missing))

    wrong = []
    for key, raw in details.items():
        if not _age_key(key):
            continue
        age = _parse_age(raw)
        if age is None:
            continue
        if age < 0:
            wrong.append("%s: got %r, ages are not negative" % (key, raw))
    if wrong:
        raise Failure("ages (live-shape): %d age(s) negative:\n  %s"
                      % (len(wrong), "\n  ".join(wrong)))

    got = _parse_age(details["front.harbor.lastTurnS"])
    want = _wall_age_s(LIVE_LAST_TURN_AT)
    if got is None or abs(got - want) > AGE_SLACK_S:
        raise Failure("ages (live-shape): front.harbor.lastTurnS: got %r, "
                      "the wall clock holds ~%.0f "
                      "(turn %s is after observed.at %s)"
                      % (details["front.harbor.lastTurnS"], want,
                         LIVE_LAST_TURN_AT, LIVE_OBSERVED_AT))

    if details["header.collectorAt"] != LIVE_OBSERVED_AT:
        raise Failure("ages (live-shape): header.collectorAt: got %r, "
                      "observed.at is %r"
                      % (details["header.collectorAt"], LIVE_OBSERVED_AT))
    cgot = _parse_age(details["header.collectorAgeS"])
    cwant = _wall_age_s(LIVE_OBSERVED_AT)
    if cgot is None or abs(cgot - cwant) > AGE_SLACK_S:
        raise Failure("ages (live-shape): header.collectorAgeS: got %r, "
                      "observed.at ages to ~%.0f"
                      % (details["header.collectorAgeS"], cwant))


def loads(state_dir: Path) -> int:
    files = check_lint()
    print("qmllint: %d QML file(s) clean" % len(files))
    # Both fixtures, each against its own hand-derived counts: the mock
    # proves the fixture renders, the live shape proves the runtime's real
    # output does. An explicit --state replaces the mock fixture only; the
    # live shape is always checked at its own path.
    mock = check_blocks(fed(state_dir), EXPECTED, "mock")
    for name in BLOCKS:
        print("mock %s %d" % (name, mock["counts"][name]))
    live = check_blocks(fed(FIXTURE_LIVE), EXPECTED_LIVE, "live-shape")
    for name in BLOCKS:
        print("live %s %d" % (name, live["counts"][name]))
    check_live_rows(live["details"])
    check_ages(live["details"])
    print("live rows: %d row fact(s) as the fixture holds them"
          % (len(EXPECTED_LIVE_ROWS) + 1))
    print("live ages: lastTurnS is the wall-clock age of a stamp after "
          "observed.at; no printed age is negative; collectorAgeS still "
          "ages observed.at")
    print("loads: the plugin lints and its model folds both fixtures "
          "into all eight blocks")
    return 0


def blocks_count(state_dir: Path) -> int:
    print(run_harness(fed(state_dir))["nonempty"])
    return 0


def run_panel_harness(state_dir: Path) -> dict:
    """The panel's header and blocks with a window on them, against
    `state_dir`.

    The panel binds qs.Commons, which only resolves inside the Omarchy
    shell's own config root, so the run gets a QML import path holding a
    `qs` entry that points at the shell — the same arrangement check_lint
    uses. Pass or fail comes from the output, never from the status."""
    quickshell = find_quickshell()
    if not PANEL_HARNESS.is_file():
        raise Failure("harness: missing " + str(PANEL_HARNESS))
    if not state_dir.is_dir():
        raise Failure("harness: no such state directory: " + str(state_dir))

    imports = REPO / ".foreman-verify-imports"
    imports.mkdir(exist_ok=True)
    link = imports / "qs"
    shell = OMARCHY / "shell"
    try:
        if link.is_symlink() or link.exists():
            link.unlink()
        if shell.is_dir():
            link.symlink_to(shell)

        env = headless_env(state_dir)
        existing = env.get("QML2_IMPORT_PATH", "")
        env["QML2_IMPORT_PATH"] = (str(imports) + (os.pathsep + existing
                                                   if existing else ""))
        output = run_quickshell(
            [quickshell, "-p", str(PANEL_HARNESS)], env)
    finally:
        if link.is_symlink():
            link.unlink()
        try:
            imports.rmdir()
        except OSError:
            pass

    trouble = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("ERROR"):
            if re.match(r"ERROR quickshell\.(paths|ipc|logging|tooling):",
                        stripped):
                continue
            trouble.append(stripped)
        elif "unresolvable import" in stripped:
            # The static scanner does not see the runtime qs -> shell
            # mapping, so it warns about qs.Commons while the engine
            # resolves it. Any other unresolvable import is a real failure.
            if EXPECTED_DANGLING_IMPORT not in stripped:
                trouble.append(stripped)
        elif "TypeError" in stripped or "ReferenceError" in stripped:
            trouble.append(stripped)
        elif stripped.startswith("SLOT-ERROR"):
            trouble.append("harness: " + stripped)
    if trouble:
        raise Failure("panel harness: the render reported errors:\n  "
                      + "\n  ".join(trouble[:10]))

    counts: dict = {}
    renders: dict = {}
    for line in output.splitlines():
        cleaned = _clean(line)
        match = re.search(r"BLOCK ([A-Za-z]+) (-?\d+)\s*$", cleaned)
        if match:
            counts[match.group(1)] = int(match.group(2))
            continue
        match = re.search(r"RENDER (\S+) (\S+) (\d+) (\{.*\})\s*$", cleaned)
        if match:
            try:
                shown = json.loads(match.group(4))
                titles = shown["titles"]
                empty = shown["empty"]
            except (ValueError, KeyError, TypeError):
                raise Failure("panel harness: unparsable render: %r"
                              % match.group(4))
            renders[match.group(1)] = {
                "status": match.group(2),
                "cards": int(match.group(3)),
                "titles": titles,
                "empty": empty,
                "details": shown.get("details", []),
            }
    if "HARNESS-DONE" not in output:
        raise Failure("panel harness: did not finish; output was:\n"
                      + output[-2000:])
    return {"counts": counts, "renders": renders}


def panel_blocks(state_dir: Path) -> int:
    """Header numbers and, for each block of this job's scope, the card
    count and title text of every card, read off the headless render.
    Slots whose files have not landed yet are reported, never asserted,
    so this stays meaningful as the other layout jobs arrive. The strict
    assertions hold the mock fixture; an explicit --state only reports
    what the render shows."""
    strict = state_dir.resolve() == FIXTURE.resolve()
    result = run_panel_harness(fed(state_dir))
    renders = result["renders"]

    missing = [name for name in ["header", *PANEL_SLOTS]
               if name not in renders]
    if missing:
        raise Failure("blocks: the panel never rendered %s"
                      % ", ".join(missing))
    broken = ["%s (%s)" % (name, renders[name]["status"])
              for name in renders if renders[name]["status"] == "error"]
    if broken:
        raise Failure("blocks: %d block file(s) failed to load:\n  %s"
                      % (len(broken), "\n  ".join(broken)))

    if strict:
        check_panel_strict(renders)

    header = renders["header"]
    print("header: %s" % " · ".join(header["titles"]))
    for name in PANEL_SLOTS:
        slot = renders[name]
        if slot["status"] != "ready":
            print("%s: not yet rendered (%s)" % (name, slot["status"]))
            continue
        print("%s: %d card(s)" % (name, slot["cards"]))
        for title in slot["titles"]:
            print("  %s" % title)
        for voice in slot["empty"]:
            print("  empty: %s" % voice)
    if strict:
        print("blocks: the header and this job's blocks render as the"
              " fixture holds them")
    else:
        print("blocks: reported without assertions (not the mock fixture)")
    return 0


def check_panel_strict(renders: dict) -> None:
    """The mock-fixture assertions: header numbers, and for each block of
    this job's scope the card count, every title, and a silent empty
    voice."""
    header = renders["header"]
    if header["titles"] != EXPECTED_PANEL_HEADER:
        raise Failure("blocks: header: got %r, the fixture holds %r"
                      % (header["titles"], EXPECTED_PANEL_HEADER))

    for name, expected in (("needsYou", EXPECTED_PANEL_NEEDSYOU),
                           ("problems", EXPECTED_PANEL_PROBLEMS)):
        slot = renders[name]
        if slot["status"] != "ready":
            raise Failure("blocks: %s: not rendered (%s)"
                          % (name, slot["status"]))
        if slot["cards"] != len(expected) or slot["titles"] != expected:
            raise Failure("blocks: %s: got %d card(s) %r, the fixture holds"
                          " %d with %r"
                          % (name, slot["cards"], slot["titles"],
                             len(expected), expected))
        if slot["empty"]:
            raise Failure("blocks: %s: empty voice shows beside %d card(s)"
                          % (name, slot["cards"]))

    slot = renders["jobQueue"]
    if slot["status"] != "ready":
        raise Failure("blocks: jobQueue: not rendered (%s)"
                      % slot["status"])
    if slot["cards"] != 1:
        raise Failure("blocks: jobQueue: got %d card(s),"
                      " the fixture holds 1" % slot["cards"])
    shown = [TAG.sub("", title) for title in slot["titles"]]
    if not shown:
        raise Failure("blocks: jobQueue: rendered no titles")
    rows = [(shown[i], shown[i + 1])
            for i in range(0, len(shown) - 1, 2)]
    if rows != EXPECTED_PANEL_JOBQUEUE \
            or shown[-1] != EXPECTED_PANEL_JOBQUEUE_SUMMARY:
        raise Failure("blocks: jobQueue: got %d row(s) %r with summary %r,"
                      " the fixture holds %d with %r"
                      % (len(rows), rows, shown[-1],
                         len(EXPECTED_PANEL_JOBQUEUE),
                         EXPECTED_PANEL_JOBQUEUE_SUMMARY))
    if slot["empty"]:
        raise Failure("blocks: jobQueue: empty voice shows beside %d row(s)"
                      % len(rows))

    # The merge body is a flow of three fragments per row (the bold target
    # cannot go through RichText offscreen), so a row joins back out of
    # its left word and three fragments.
    slot = renders["mergeQueue"]
    if slot["status"] != "ready":
        raise Failure("blocks: mergeQueue: not rendered (%s)"
                      % slot["status"])
    if slot["cards"] != 1:
        raise Failure("blocks: mergeQueue: got %d card(s),"
                      " the fixture holds 1" % slot["cards"])
    shown = [TAG.sub("", title) for title in slot["titles"]]
    if not shown:
        raise Failure("blocks: mergeQueue: rendered no titles")
    rows = [(shown[i], shown[i + 1] + shown[i + 2] + shown[i + 3])
            for i in range(0, len(shown) - 1, 4)]
    if rows != EXPECTED_PANEL_MERGEQUEUE \
            or shown[-1] != EXPECTED_PANEL_MERGEQUEUE_SUMMARY:
        raise Failure("blocks: mergeQueue: got %d row(s) %r with summary"
                      " %r, the fixture holds %d with %r"
                      % (len(rows), rows, shown[-1],
                         len(EXPECTED_PANEL_MERGEQUEUE),
                         EXPECTED_PANEL_MERGEQUEUE_SUMMARY))
    if slot["empty"]:
        raise Failure("blocks: mergeQueue: empty voice shows beside %d"
                      " row(s)" % len(rows))

    slot = renders["frontQueue"]
    if slot["status"] != "ready":
        raise Failure("blocks: frontQueue: not rendered (%s)"
                      % slot["status"])
    if slot["cards"] != 1:
        raise Failure("blocks: frontQueue: got %d card(s),"
                      " the fixture holds 1" % slot["cards"])
    shown = [TAG.sub("", title) for title in slot["titles"]]
    rows = [(shown[i], shown[i + 1]) for i in range(0, len(shown), 2)]
    if rows != EXPECTED_PANEL_FRONTQUEUE:
        raise Failure("blocks: frontQueue: got %d row(s) %r, the fixture"
                      " holds %d with %r"
                      % (len(rows), rows, len(EXPECTED_PANEL_FRONTQUEUE),
                         EXPECTED_PANEL_FRONTQUEUE))
    if slot["empty"]:
        raise Failure("blocks: frontQueue: empty voice shows beside %d"
                      " row(s)" % len(rows))

    slot = renders["capacity"]
    if slot["status"] != "ready":
        raise Failure("blocks: capacity: not rendered (%s)" % slot["status"])
    if slot["cards"] != len(EXPECTED_PANEL_CAPACITY):
        raise Failure("blocks: capacity: got %d card(s), the fixture holds"
                      " %d" % (slot["cards"], len(EXPECTED_PANEL_CAPACITY)))
    shown = [TAG.sub("", title) for title in slot["titles"]]
    pools = [(shown[i], shown[i + 1], shown[i + 2])
             for i in range(0, len(shown), 3)]
    if pools != EXPECTED_PANEL_CAPACITY:
        raise Failure("blocks: capacity: got %r, the fixture holds %r"
                      % (pools, EXPECTED_PANEL_CAPACITY))
    if slot["empty"]:
        raise Failure("blocks: capacity: empty voice shows beside %d"
                      " card(s)" % slot["cards"])
    slot = renders["working"]
    if slot["status"] != "ready":
        raise Failure("blocks: working: not rendered (%s)" % slot["status"])
    expected_titles = [title for title, _, _, _ in EXPECTED_PANEL_WORKING]
    if slot["cards"] != len(expected_titles) or slot["titles"] != expected_titles:
        raise Failure("blocks: working: got %d card(s) %r, the fixture holds"
                      " %d with %r"
                      % (slot["cards"], slot["titles"],
                         len(expected_titles), expected_titles))
    if slot["empty"]:
        raise Failure("blocks: working: empty voice shows beside %d card(s)"
                      % slot["cards"])
    details = slot.get("details", [])
    got = [(card.get("title", ""), card.get("tone", ""),
            card.get("tasks", -1), card.get("monitors", ""))
           for card in details]
    if got != EXPECTED_PANEL_WORKING:
        raise Failure("blocks: working: got %r, the fixture holds %r"
                      % (got, EXPECTED_PANEL_WORKING))


#: What `panel --keys` must see on the headless run against a throwaway
#: copy of the mock fixture. Hand-derived from the fixture bytes, never
#: from a run of the panel under test:
#:
#:   needsYou  inbox.jsonl sorted by asked_at, answered rows dropped:
#:             inb-tokens01 (options yes/no) then inb-reaper01 (yes/no)
#:   approve   the row's first option ("yes" for both fixture items)
#:   decline   the row's second option ("no" for both fixture items)
#:   problems  anomalies.jsonl in ledger order, resolved rows dropped;
#:             the defect-repeated row carries no action and gets no hint:
#:             supervisor silent ("foreman relaunch ses-supeng01") then
#:             intruder ("foreman kill ses-wcorp002 --reason
#:             intruder-pid-41180")
#:   hints     assigned on appearance in model order (needsYou approve
#:             then decline per item, then problems), aa down the alphabet
#:             without f: aa ab ac ad ae ag
#:   queue     freeze, then one answer per inbox item (approve the first,
#:             decline the second, so both answer variants fire without
#:             answering one item twice), then each Problem verbatim
EXPECTED_KEYS = [
    ("aa", "answer:inb-tokens01:approve",
     ["answer", "inb-tokens01", "yes"]),
    ("ab", "answer:inb-tokens01:decline",
     ["answer", "inb-tokens01", "no"]),
    ("ac", "answer:inb-reaper01:approve",
     ["answer", "inb-reaper01", "yes"]),
    ("ad", "answer:inb-reaper01:decline",
     ["answer", "inb-reaper01", "no"]),
    ("ae", "problem:supervisor silent:ses-supeng01",
     ["relaunch", "ses-supeng01"]),
    ("ag", "problem:intruder:pid-41180",
     ["kill", "ses-wcorp002", "--reason", "intruder-pid-41180"]),
]
EXPECTED_KEYS_QUEUE = [
    "static:freeze",
    "answer:inb-tokens01:approve",
    "answer:inb-reaper01:decline",
    "problem:supervisor silent:ses-supeng01",
    "problem:intruder:pid-41180",
]
#: The answers the ledger must hold after the run, derived by hand from
#: the fixture's own options arrays (approve = first option, decline =
#: second), not from a run of the panel's code.
EXPECTED_KEYS_ANSWERS = {
    "inb-tokens01": "yes",
    "inb-reaper01": "no",
}
#: The kill the intruder row runs, hand-derived from the fixture bytes the
#: same way: the action names roster session ses-wcorp002 (whose running
#: job is job-cor-3 on front corpus) with a one-token reason, so the verb
#: the panel runs verbatim succeeds against the throwaway copy.
EXPECTED_KEYS_KILL_ID = "problem:intruder:pid-41180"
EXPECTED_KEYS_KILL_SESSION = "ses-wcorp002"
EXPECTED_KEYS_KILL_JOB = "job-cor-3"
EXPECTED_KEYS_KILL_FRONT = "corpus"
EXPECTED_KEYS_KILL_REASON = "intruder-pid-41180"

HINT_RE = re.compile(r"^[a-e,g-z][a-e,g-z]$")


def fold_ledger(path: Path) -> dict:
    """Last line wins over a JSONL ledger, first appearance keeps order."""
    by_id: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return by_id
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict) and record.get("id"):
            by_id[record["id"]] = record
    return by_id


def run_keys_harness(state_dir: Path, session: str | None = None) -> list[str]:
    """The panel's own Keys singleton against `state_dir`, driven through
    the same entry points Panel.qml's key handler calls. Every fire runs
    the real `foreman` verb through Keys' Process (FOREMAN_STATE points at
    the throwaway copy). The driven run is attributed to `session`: None
    leaves FOREMAN_SESSION unset, anything else names it outright, so the
    ambient value can never leak in."""
    quickshell = find_quickshell()
    if not KEYS_HARNESS.is_file():
        raise Failure("harness: missing " + str(KEYS_HARNESS))
    if not state_dir.is_dir():
        raise Failure("harness: no such state directory: " + str(state_dir))

    env = headless_env(state_dir)
    if session is not None:
        env["FOREMAN_SESSION"] = session
    # A run that never settles (HARNESS-DONE deadline) or never answers
    # (120s of silence) is retried like a runner that dies before
    # reporting: the harness quits by its own hard deadline, so either
    # silence is the headless runner stalling on its own, never the code
    # under test. A run that reports is judged on its output exactly
    # once, and a failure that persists across every attempt still fails.
    output = ""
    for attempt in range(HARNESS_ATTEMPTS):
        try:
            output = run_quickshell(
                [quickshell, "-p", str(KEYS_HARNESS)], env)
        except subprocess.TimeoutExpired:
            if attempt == HARNESS_ATTEMPTS - 1:
                raise
            output = ""
            continue
        if "HARNESS-DONE settled" in _clean(output):
            break

    trouble = []
    for line in output.splitlines():
        stripped = line.strip()
        if stripped.startswith("ERROR"):
            if re.match(r"ERROR quickshell\.(paths|ipc|logging|tooling):",
                        stripped):
                continue
            trouble.append(stripped)
        elif "unresolvable import" in stripped:
            if EXPECTED_DANGLING_IMPORT not in stripped:
                trouble.append(stripped)
        elif "TypeError" in stripped or "ReferenceError" in stripped:
            trouble.append(stripped)
        elif "KEY-SKIP" in stripped:
            trouble.append("harness: " + stripped)
    if trouble:
        raise Failure("keys harness: the run reported errors:\n  "
                      + "\n  ".join(trouble[:10]))
    if "HARNESS-DONE" not in output:
        raise Failure("keys harness: did not finish; output was:\n"
                      + output[-2000:])
    return output.splitlines()


#: The caller identities --keys must be immune to, each run against a
#: fresh copy of the fixture with the full assertions: no session (the
#: owner's own desktop), a supervisor-shaped id the fixture never
#: registered, and outright nonsense. The panel's Process names its own
#: caller, so all three pass identically; if it ever inherits the ambient
#: value again, the hostile two fail.
KEYS_SESSIONS = [
    ("unset", None),
    ("stray-supervisor", "ses-faez2af"),
    ("nonsense", "not-a-session"),
]


def _scrub_throwaway_pids(tmp: Path) -> None:
    """The throwaway roster carries no pids. The mock records processes the
    machine never ran, and a recorded pid without a starttime is trusted,
    so the kill this check proves could otherwise signal a live process
    that happens to reuse the number. With no pid the kill stops nothing
    and still writes its roster and job lines, which is what is proven."""
    roster_path = tmp / "roster.json"
    try:
        roster = json.loads(roster_path.read_text())
    except (OSError, ValueError):
        raise Failure("keys: the throwaway copy has no readable roster.json")
    sessions = roster.get("sessions")
    if not isinstance(sessions, dict):
        raise Failure("keys: the throwaway roster holds no sessions")
    for record in sessions.values():
        if isinstance(record, dict):
            record["pid"] = None
            record["pgid"] = None
    roster_path.write_text(json.dumps(roster) + "\n")


def panel_keys(state_dir: Path) -> int:
    """Every key against a throwaway copy of the fixture, asserting the
    ledger line the verb wrote, once per caller in KEYS_SESSIONS. The
    mock fixture is copied to a temporary directory, its roster pids are
    scrubbed so the proven kill can signal no real process, and
    FOREMAN_STATE points at the copy; the real state directory is never
    touched. Answers, the freeze and the kill are proven against the
    ledgers; the cheat sheet, Esc and the panel's reflection of the
    change are proven against the harness report; the relaunch the CLI
    cannot run against the fixture is attempted verbatim and reported
    unproven. A wrong-row probe types a first letter, lands a new row
    underneath, and proves the pending letter cancels and the second
    letter fires nothing."""
    if not FIXTURE.is_dir():
        raise Failure("keys: no such fixture: " + str(FIXTURE))
    proven: dict = {}
    for label, session in KEYS_SESSIONS:
        tmp = Path(tempfile.mkdtemp(prefix="foreman-keys-"))
        try:
            shutil.copytree(FIXTURE, tmp, dirs_exist_ok=True)
            _scrub_throwaway_pids(tmp)
            # The panel reads the summary and no ledger, so the copy is fed
            # once before the run. Every key then fires a real verb, and the
            # verb writes the summary again on its way out: that is what
            # makes the panel show the answer it just wrote.
            fold_panel(tmp)
            proven[label] = check_keys_once(tmp, label, session)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    done = proven["unset"]
    print("keys: UNPROVEN relaunch ses-supeng01 "
          "(exit %s: the fixture carries no vendor session and no repo, "
          "so the verb refuses)"
          % done["problem:supervisor silent:ses-supeng01"])
    print("keys: kill ses-wcorp002 runs its verb (exit %s: the roster "
          "and job-cor-3 hold killed, by the owner, for "
          "intruder-pid-41180)"
          % done[EXPECTED_KEYS_KILL_ID])
    print("keys: every provable key did its verb against the "
          "throwaway copy, under every caller (%s)"
          % ", ".join(label for label, _ in KEYS_SESSIONS))
    return 0


def check_keys_once(tmp: Path, label: str, session: str | None) -> dict:
    """One caller scenario of --keys: drive every key, assert the ledger
    lines, and return the exit codes by action id. A Failure names the
    scenario that broke."""
    try:
        lines = run_keys_harness(tmp, session)

        hints: dict = {}
        verbs: dict = {}
        done: dict = {}
        queue: list = []
        report: dict = {}
        wrongrow: dict = {}
        noverb: set = set()
        # console.log lines arrive with quickshell's own "DEBUG qml: "
        # prefix, so every marker is searched, never startswith-matched.
        for line in lines:
            cleaned = _clean(line).strip()
            match = re.search(r"HINT ([A-Za-z]+) (.+?) (\[.*?\])\s*$",
                              cleaned)
            if match:
                hint, aid, argv_json = match.groups()
                try:
                    argv = json.loads(argv_json)
                except ValueError:
                    raise Failure("keys: unparsable HINT argv: %r" % cleaned)
                hints[aid] = hint
                verbs[aid] = argv
                continue
            match = re.search(r"KEY-DONE (.+) (\d+)\s*$", cleaned)
            if match:
                done[match.group(1)] = match.group(2)
                continue
            match = re.search(r"KEY-NOVERB (\S+)", cleaned)
            if match:
                noverb.add(match.group(1))
                continue
            match = re.search(r"QUEUE (.+?)\s*$", cleaned)
            if match:
                queue = match.group(1).split(",")
                continue
            # The lookbehind keeps WRONGROW-PENDING from matching as
            # PENDING: the probe's markers are parsed below, never here.
            match = re.search(r"(?<![A-Z-])(CHEAT-OPEN|CHEAT-ESC|PENDING|PENDING-ESC|"
                              r"NEEDSYOU-BEFORE|NEEDSYOU-AFTER|"
                              r"FROZEN-BEFORE|FROZEN-AFTER) (\S+)\s*$",
                              cleaned)
            if match:
                report[match.group(1)] = match.group(2)
                continue
            match = re.search(r"WRONGROW-(PENDING|CANCELLED|NOFIRE|FIRED) (\S+)\s*$",
                              cleaned)
            if match:
                wrongrow[match.group(1)] = match.group(2)

        # The six dynamic hints, exactly as the fixture holds them.
        want_hints = {aid: hint for hint, aid, _ in EXPECTED_KEYS}
        if hints != want_hints:
            raise Failure("keys: hints: got %r, the fixture holds %r"
                          % (hints, want_hints))
        for hint in hints.values():
            if not HINT_RE.match(hint):
                raise Failure("keys: hint %r is not two letters outside f"
                              % hint)
        if len(set(hints.values())) != len(hints):
            raise Failure("keys: hints are not unique: %r" % hints)
        want_verbs = {aid: argv for _, aid, argv in EXPECTED_KEYS}
        if verbs != want_verbs:
            raise Failure("keys: verbs: got %r, the fixture holds %r"
                          % (verbs, want_verbs))
        if queue != EXPECTED_KEYS_QUEUE:
            raise Failure("keys: queue: got %r, the fixture holds %r"
                          % (queue, EXPECTED_KEYS_QUEUE))

        # Static keys through the same entry points the panel uses.
        if report.get("CHEAT-OPEN") != "true":
            raise Failure("keys: ? did not open the cheat sheet: %r"
                          % report.get("CHEAT-OPEN"))
        if report.get("CHEAT-ESC") != "cheat-closed":
            raise Failure("keys: Esc did not close the cheat sheet: %r"
                          % report.get("CHEAT-ESC"))
        if report.get("PENDING") != "a":
            raise Failure("keys: first letter did not narrow: %r"
                          % report.get("PENDING"))
        if report.get("PENDING-ESC") != "pending-cleared":
            raise Failure("keys: Esc did not back out of the pending "
                          "letter: %r" % report.get("PENDING-ESC"))
        if report.get("NEEDSYOU-BEFORE") != "2":
            raise Failure("keys: Needs you held %s before, the fixture "
                          "holds 2" % report.get("NEEDSYOU-BEFORE"))
        if report.get("FROZEN-BEFORE") != "false":
            raise Failure("keys: swarm was already frozen before F")

        # Every fire the panel ran, by exit code: the freeze and both
        # answers must succeed; the Problems verbs are attempted verbatim
        # and their failures are unproven work, not test failures.
        for aid in EXPECTED_KEYS_QUEUE:
            if aid not in done:
                raise Failure("keys: %s never ran" % aid)
        if done["static:freeze"] != "0":
            raise Failure("keys: F did not freeze: exit %s"
                          % done["static:freeze"])
        for aid in ("answer:inb-tokens01:approve",
                    "answer:inb-reaper01:decline"):
            if done[aid] != "0":
                raise Failure("keys: %s did not answer: exit %s"
                              % (aid, done[aid]))

        # The ledger lines the verbs should have written, read off the
        # throwaway copy and compared against hand-derived literals.
        inbox = fold_ledger(tmp / "inbox.jsonl")
        for iid, answer in EXPECTED_KEYS_ANSWERS.items():
            row = inbox.get(iid, {})
            if row.get("answered_at") in (None, "") \
                    or row.get("answer") != answer:
                raise Failure("keys: %s: got answer %r, the verb should "
                              "have written %r"
                              % (iid, row.get("answer"), answer))
        frozen = tmp / "frozen"
        try:
            frozen_text = frozen.read_text()
        except OSError:
            raise Failure("keys: F: no frozen file after `foreman freeze`")
        if not frozen_text.startswith("frozen"):
            raise Failure("keys: F: frozen file holds %r" % frozen_text)

        # The panel reflects the change on its next tick: both answers
        # landed, so nothing is left in Needs you, and the swarm is frozen.
        if report.get("NEEDSYOU-AFTER") != "0":
            raise Failure("keys: answered questions still in Needs you: "
                          "%s" % report.get("NEEDSYOU-AFTER"))
        if report.get("FROZEN-AFTER") != "true":
            raise Failure("keys: panel does not show the freeze: %s"
                          % report.get("FROZEN-AFTER"))

        # The wrong-row probe: a first letter pending while a row lands
        # underneath must cancel, the second letter must fire nothing,
        # and the new row's full hint must fire the new row. The probe
        # question is answered on the way out, so NEEDSYOU-AFTER above
        # already counts it.
        if wrongrow.get("PENDING") != "pending":
            raise Failure("keys: probe first letter did not narrow: %r"
                          % wrongrow.get("PENDING"))
        if wrongrow.get("CANCELLED") != "true":
            raise Failure("keys: half-typed hint survived the model "
                          "change; the second letter would fire the "
                          "new row: %r" % wrongrow.get("CANCELLED"))
        if wrongrow.get("NOFIRE") != "true":
            raise Failure("keys: the second letter fired after the map "
                          "changed: %r" % wrongrow.get("NOFIRE"))
        fired = wrongrow.get("FIRED", "")
        probe_match = re.match(r"fired:answer:(.+):approve$", fired)
        if not probe_match:
            raise Failure("keys: the new row's hint did not fire the "
                          "new row: %r" % fired)
        probe_row = inbox.get(probe_match.group(1), {})
        if probe_row.get("answered_at") in (None, "") \
                or probe_row.get("answer") != "yes":
            raise Failure("keys: probe %r: got answer %r, the verb "
                          "should have written 'yes'"
                          % (probe_match.group(1),
                             probe_row.get("answer")))

        # The probe asks what the runtime ships, so no key may report an
        # absent verb here: every verb on screen exists, and a KEY-NOVERB
        # line means the hard-coded list is back.
        if noverb:
            raise Failure("keys: a key reported its verb absent: %r"
                          % sorted(noverb))

        # The kill key runs its verb for real: exit 0, the roster session
        # killed by the owner for the row's reason, and its running job
        # killed with the same hand and reason.
        if done.get(EXPECTED_KEYS_KILL_ID) != "0":
            raise Failure("keys: %s did not run its verb: exit %s"
                          % (EXPECTED_KEYS_KILL_ID,
                             done.get(EXPECTED_KEYS_KILL_ID)))
        try:
            roster = json.loads((tmp / "roster.json").read_text())
            killed = roster["sessions"][EXPECTED_KEYS_KILL_SESSION]
        except (OSError, ValueError, KeyError, TypeError):
            raise Failure("keys: the throwaway roster no longer names %s"
                          % EXPECTED_KEYS_KILL_SESSION)
        for field, want in (("state", "killed"),
                            ("killed_by", "owner"),
                            ("killed_reason", EXPECTED_KEYS_KILL_REASON)):
            if killed.get(field) != want:
                raise Failure("keys: roster %s holds %r for %s, the kill "
                              "should have written %r"
                              % (EXPECTED_KEYS_KILL_SESSION,
                                 killed.get(field), field, want))
        jobs = fold_ledger(tmp / "fronts" / EXPECTED_KEYS_KILL_FRONT
                           / "jobs.jsonl")
        job = jobs.get(EXPECTED_KEYS_KILL_JOB, {})
        for field, want in (("state", "killed"),
                            ("killed_reason", EXPECTED_KEYS_KILL_REASON)):
            if job.get(field) != want:
                raise Failure("keys: job %s holds %r for %s, the kill "
                              "should have written %r"
                              % (EXPECTED_KEYS_KILL_JOB, job.get(field),
                                 field, want))

        print("keys [%s]: F runs `foreman freeze` (frozen file %r)"
              % (label, frozen_text.splitlines()[0]))
        for iid, answer in EXPECTED_KEYS_ANSWERS.items():
            print("keys [%s]: %s runs `foreman answer %s %s` "
                  "(ledger holds %r)"
                  % (label, hints["answer:%s:%s" % (
                      iid, "approve" if iid == "inb-tokens01" else "decline")],
                      iid, answer, answer))
        print("keys [%s]: ? opens the cheat sheet, Esc backs out one level"
              % label)
        print("keys [%s]: answered questions leave Needs you on the next "
              "tick" % label)
        print("keys [%s]: half-typed hint cancels when rows change (%s); "
              "the new hint fires the new row (%s)" % (label,
                                                       wrongrow.get("CANCELLED"),
                                                       wrongrow.get("FIRED")))
        print("keys [%s]: %s runs `foreman kill %s --reason %s` "
              "(exit 0: the roster and the job hold killed)"
              % (label, hints[EXPECTED_KEYS_KILL_ID],
                 EXPECTED_KEYS_KILL_SESSION, EXPECTED_KEYS_KILL_REASON))
        return done
    except Failure as failure:
        raise Failure("keys [%s]: %s" % (label, failure))


#: The managed bindings block install writes, hand-derived from
#: src/foreman/panel_binding.py (the source of truth), never imported from
#: it: this check must fail aloud when the block text changes, the way the
#: block-count literals fail when a fixture changes.
EXPECTED_BINDING_BLOCK = """-- >>> foreman-panel
-- Managed by the Foreman panel. Edits inside this block are lost on reinstall.
-- Summon and dismiss the Foreman panel.
o.bind("SUPER + M", "Foreman panel", "omarchy-shell shell toggle foreman")
-- <<< foreman-panel"""

#: The seeded shell.json: stock-shaped, deliberately not in the writer's
#: own canonical form (four-space indent, an extra top-level key), so the
#: round trip proves byte restoration rather than reformatting luck.
SHELL_SEED = b"""{
    "version": 1,
    "idle": {"screensaver": 600},
    "bar": {
        "layout": {
            "right": [
                {"id": "omarchy.tray"}
            ]
        }
    },
    "plugins": []
}
"""

#: The seeded bindings file ends in three newlines: the Astra-found case.
BINDINGS_SEED = b'-- stock hyprland bindings\nbind = SUPER, Q, killactive\n\n\n'

#: A bindings file that already binds Super+M outside any managed block.
BINDINGS_TAKEN = b'o.bind("SUPER + M", "mine", "something else")\n'


def _tree_snapshot(root: Path) -> dict:
    """Every file and link under root: exact bytes or link target."""
    out = {}
    for path in sorted(root.rglob("*")):
        rel = str(path.relative_to(root))
        if path.is_symlink():
            out[rel] = ("link", os.readlink(path))
        elif path.is_file():
            out[rel] = ("file", path.read_bytes())
    return out


def _install_env(home: Path) -> dict:
    """The temporary home as the whole world: HOME points at it, the
    shell is never reloaded, and no ambient Foreman identity leaks in."""
    env = dict(os.environ)
    env["HOME"] = str(home)
    env["FOREMAN_NO_RELOAD"] = "1"
    env.pop("FOREMAN_SESSION", None)
    env.pop("FOREMAN_STATE", None)
    env.pop("FOREMAN_CONFIG", None)
    return env


def _run_install_script(home: Path, verb: str) -> subprocess.CompletedProcess:
    script = REPO / ("install" if verb == "install" else "uninstall")
    if not script.is_file():
        raise Failure("install-roundtrip: missing executable: %s" % script)
    return subprocess.run([str(script)], capture_output=True, text=True,
                          timeout=120, env=_install_env(home))


def _assert_three_things(home: Path, label: str) -> None:
    """The symlink, the registration, the binding block — each asserted
    structurally, never via the installer's own helpers."""
    link = (home / ".config" / "omarchy" / "plugins" / "foreman")
    if not link.is_symlink():
        raise Failure("install-roundtrip [%s]: no plugin symlink at %s"
                      % (label, link))
    if link.resolve() != (REPO / "plugin" / "foreman").resolve():
        raise Failure("install-roundtrip [%s]: the symlink points at %s"
                      % (label, link.resolve()))
    shell_json = home / ".config" / "omarchy" / "shell.json"
    try:
        doc = json.loads(shell_json.read_text())
    except (OSError, ValueError):
        raise Failure("install-roundtrip [%s]: %s is missing or not JSON"
                      % (label, shell_json))
    try:
        right = doc["bar"]["layout"]["right"]
    except (KeyError, TypeError):
        raise Failure("install-roundtrip [%s]: no bar.layout.right in %s"
                      % (label, shell_json))
    if {"id": "foreman"} not in right:
        raise Failure("install-roundtrip [%s]: no foreman entry in "
                      "bar.layout.right" % label)
    if any((w.get("id") if isinstance(w, dict) else w) == "foreman"
           for w in doc.get("plugins", [])):
        raise Failure("install-roundtrip [%s]: foreman does not belong in "
                      "plugins[]; the bar entry enables the panel too"
                      % label)
    bindings = home / ".config" / "hypr" / "bindings.lua"
    try:
        text = bindings.read_text()
    except OSError:
        raise Failure("install-roundtrip [%s]: no bindings file at %s"
                      % (label, bindings))
    if EXPECTED_BINDING_BLOCK not in text:
        raise Failure("install-roundtrip [%s]: the managed block is not "
                      "what panel_binding.py writes" % label)


def _roundtrip_once(home: Path, label: str) -> None:
    """Install, install again, uninstall: exact at every step."""
    before = _tree_snapshot(home)
    first = _run_install_script(home, "install")
    if first.returncode != 0:
        raise Failure("install-roundtrip [%s]: install exited %d:\n%s"
                      % (label, first.returncode,
                         first.stdout + first.stderr))
    _assert_three_things(home, label)
    print("install-roundtrip [%s]: symlink, registration and binding "
          "block in place" % label)
    installed = _tree_snapshot(home)
    if installed == before:
        raise Failure("install-roundtrip [%s]: install changed nothing"
                      % label)
    second = _run_install_script(home, "install")
    if second.returncode != 0:
        raise Failure("install-roundtrip [%s]: second install exited %d"
                      % (label, second.returncode))
    if _tree_snapshot(home) != installed:
        raise Failure("install-roundtrip [%s]: the second install was "
                      "not a no-op" % label)
    print("install-roundtrip [%s]: second install changed nothing "
          "further" % label)
    third = _run_install_script(home, "uninstall")
    if third.returncode != 0:
        raise Failure("install-roundtrip [%s]: uninstall exited %d:\n%s"
                      % (label, third.returncode,
                         third.stdout + third.stderr))
    after = _tree_snapshot(home)
    if after != before:
        missing = [k for k in before if k not in after]
        extra = [k for k in after if k not in before]
        changed = [k for k in before if k in after
                   and before[k] != after[k]]
        raise Failure("install-roundtrip [%s]: the tree did not come "
                      "back: missing %r, added %r, changed %r"
                      % (label, missing, extra, changed))
    print("install-roundtrip [%s]: uninstall restored every byte" % label)


def _refusal(home: Path) -> None:
    """Super+M already taken: install refuses and the file is untouched."""
    bindings = home / ".config" / "hypr" / "bindings.lua"
    bindings.parent.mkdir(parents=True, exist_ok=True)
    bindings.write_bytes(BINDINGS_TAKEN)
    before = _tree_snapshot(home)
    result = _run_install_script(home, "install")
    if "refused" not in (result.stdout + result.stderr):
        raise Failure("install-roundtrip [refused]: install did not say "
                      "it refused the taken Super+M")
    if bindings.read_bytes() != BINDINGS_TAKEN:
        raise Failure("install-roundtrip [refused]: install rewrote the "
                      "file it refused")
    print("install-roundtrip [refused]: install refused, file untouched")
    gone = _run_install_script(home, "uninstall")
    if gone.returncode != 0:
        raise Failure("install-roundtrip [refused]: uninstall exited %d"
                      % gone.returncode)
    if _tree_snapshot(home) != before:
        raise Failure("install-roundtrip [refused]: uninstall did not "
                      "restore the tree around the refused file")
    print("install-roundtrip [refused]: uninstall restored the rest")


#: How long `--stall` watches the main thread, and the lateness that counts
#: as a block. A 100 ms timer cannot run late unless something else held the
#: thread, so the lateness is the block; 50 ms is well above scheduler noise
#: on an idle box and well below anything a human would call a freeze.
STALL_MS = int(os.environ.get("FOREMAN_PROBE_MS") or 60000)
STALL_GAP_MS = 50


def stall(state_dir: Path) -> int:
    """Watch the model layer hold the main thread, and say by how much.

    The probe is a 100 ms timer beside a live Model. It reports the block
    counts at the start and at the end as well as the lateness, because a
    model that folds nothing never blocks: without the counts, an empty
    panel passes as a fast one.
    """
    quickshell = find_quickshell()
    if not STALL_PROBE.is_file():
        raise Failure("stall: missing " + str(STALL_PROBE))
    env = headless_env(fed(state_dir))
    env["FOREMAN_PROBE_MS"] = str(STALL_MS)
    try:
        result = subprocess.run(
            [quickshell, "-p", str(STALL_PROBE)], capture_output=True,
            text=True, timeout=STALL_MS / 1000.0 + 120, env=env)
    except subprocess.TimeoutExpired:
        raise Failure("stall: the probe never finished in %d ms + 120 s; a "
                      "run that cannot report its own lateness is itself the "
                      "worst possible result" % STALL_MS)
    output = _clean(result.stdout + result.stderr)

    done = re.search(r"PROBE done ticks=(\d+) over50=(\d+) worst=(\d+) "
                     r"blockedMs=(\d+)", output)
    if not done:
        raise Failure("stall: the probe printed no summary; output was:\n"
                      + output[-2000:])
    ticks, over, worst, blocked = (int(g) for g in done.groups())

    counts = dict(re.findall(r"(\w+)=(-?\d+)",
                             re.search(r"PROBE counts at-end (.*)", output).group(1))
                  ) if re.search(r"PROBE counts at-end", output) else {}
    missing = [name for name in BLOCKS if name not in counts]
    if missing:
        raise Failure("stall: the probe never reported the block counts (%s); "
                      "speed with nothing rendered is not a pass"
                      % ", ".join(missing))
    for name in BLOCKS:
        print("stall block %s %s" % (name, counts[name]))
    if not any(int(counts[name]) > 0 for name in BLOCKS):
        raise Failure("stall: every block came back empty, so the probe "
                      "measured a model that folds nothing")
    for line in output.splitlines():
        if line.strip().startswith("STALL "):
            print(line.strip())
    print("stall: %d tick(s) in %d ms, %d over %d ms, worst %d ms, "
          "%d ms blocked" % (ticks, STALL_MS, over, STALL_GAP_MS, worst,
                             blocked))
    return 0


def install_roundtrip(state_dir: Path) -> int:
    """The whole plugin, installed and uninstalled inside temporary homes.

    Two round trips (a seeded home and a bare one) plus the taken-key
    refusal. --state does not apply: the homes are always thrown away.
    """
    del state_dir
    for label, shell, binds in (("seeded", SHELL_SEED, BINDINGS_SEED),
                                ("bare", None, None)):
        home = Path(tempfile.mkdtemp(prefix="foreman-install-"))
        try:
            if shell is not None:
                target = home / ".config" / "omarchy" / "shell.json"
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(shell)
            if binds is not None:
                target = home / ".config" / "hypr" / "bindings.lua"
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(binds)
            _roundtrip_once(home, label)
        finally:
            shutil.rmtree(home, ignore_errors=True)
    home = Path(tempfile.mkdtemp(prefix="foreman-install-"))
    try:
        target = home / ".config" / "omarchy" / "shell.json"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(SHELL_SEED)
        _refusal(home)
    finally:
        shutil.rmtree(home, ignore_errors=True)
    print("install-roundtrip: install, reinstall and uninstall reverse "
          "exactly; a taken Super+M refuses with the file untouched")
    return 0


NOT_IMPLEMENTED: dict = {
}


def main(argv: list[str]) -> int:
    # The check is spelled as a flag (`panel --loads`), so it is pulled out of
    # argv before argparse sees it and treats it as an option of its own.
    parser = argparse.ArgumentParser(
        prog="foreman-verify",
        usage="foreman-verify <front> <check> [--state DIR]",
        description="Verify one front's work, one check at a time.")
    parser.add_argument("front", help="the front to verify (panel)")
    parser.add_argument("--state", default=str(FIXTURE),
                        help="state directory to read (default: the fixture)")

    known = set(NOT_IMPLEMENTED) | {"--loads", "--blocks-count", "--blocks",
                                         "--keys", "--stall",
                                         "--install-roundtrip"}
    rest, check = [], None
    for token in argv:
        if token in known and check is None:
            check = token
        else:
            rest.append(token)
    if check is None:
        parser.print_usage(sys.stderr)
        print("foreman-verify: no check named; one of "
              + ", ".join(sorted(known)), file=sys.stderr)
        return 2
    args = parser.parse_args(rest)
    args.check = check

    if args.front != "panel":
        print("foreman-verify: not implemented yet: front %r" % args.front,
              file=sys.stderr)
        return 2
    if args.check in NOT_IMPLEMENTED:
        print("foreman-verify: not implemented yet: %s (%s)"
              % (args.check, NOT_IMPLEMENTED[args.check]), file=sys.stderr)
        return 2

    checks = {"--loads": loads, "--blocks-count": blocks_count,
              "--blocks": panel_blocks, "--keys": panel_keys,
              "--stall": stall, "--install-roundtrip": install_roundtrip}
    if args.check not in checks:
        print("foreman-verify: unknown check %r for front panel" % args.check,
              file=sys.stderr)
        return 2

    try:
        return checks[args.check](Path(args.state).expanduser())
    except Failure as failure:
        print("foreman-verify panel %s FAILED\n%s" % (args.check, failure),
              file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired as expired:
        print("foreman-verify panel %s FAILED\ntimed out running %s"
              % (args.check, expired.cmd), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
