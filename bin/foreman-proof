# --------------------------------------------------------------------------
# v5: one clause file per module under proof/v5/
# --------------------------------------------------------------------------

V5_DIR_NAME = "proof/v5"
V5_DIR = REPO / "proof" / "v5"
CLAUSE_FILE_RE = re.compile(r"^m(\d+)_[A-Za-z0-9_]+\.py$")
FINISH_FILE_RE = re.compile(r"^f(\d+)_[A-Za-z0-9_]+\.py$")


def discover_v5_files(milestone: int | None = None,
                      directory: Path | None = None) -> list[Path]:
    """Milestone then finish-line clause files, sorted by file name.

    ``m<N>_<slug>.py`` is a milestone clause. ``f<N>_<slug>.py`` is a
    finish-line clause, included only when ``--milestone`` is omitted so
    ``bin/foreman-proof v5`` runs milestones 0-6 then the finish line.
    Never imported as a package.
    """
    source = directory if directory is not None else V5_DIR
    if not source.is_dir():
        return []
    milestone_files: list[Path] = []
    finish_files: list[Path] = []
    for path in sorted(source.iterdir(), key=lambda p: p.name):
        if not path.is_file():
            continue
        match = CLAUSE_FILE_RE.match(path.name)
        if match is not None:
            if milestone is not None and int(match.group(1)) != milestone:
                continue
            milestone_files.append(path)
            continue
        if milestone is not None:
            continue
        if FINISH_FILE_RE.match(path.name) is not None:
            finish_files.append(path)
    return milestone_files + finish_files


def load_clause_file(path: Path):
    """Load a clause module by path. Failure, Skip, run_foreman are injected."""
    name = f"_foreman_proof_{path.stem}"
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise Failure(f"cannot load clause file {path.name}")
    module = importlib.util.module_from_spec(spec)
    module.Failure = Failure
    module.Skip = Skip
    module.run_foreman = run_foreman
    module.run_live_foreman = run_live_foreman
    module.assert_world = assert_world
    module.isolate_queued_fronts = isolate_queued_fronts
    sys.modules[name] = module
    spec.loader.exec_module(module)
    clause = getattr(module, "CLAUSE", None)
    if not (isinstance(clause, tuple) and len(clause) == 2):
        raise Failure(f"{path.name} must define CLAUSE = (id, title)")
    if not callable(getattr(module, "run", None)):
        raise Failure(f"{path.name} must define def run(world)")
    return module


def list_v5_clauses(files: list[Path]) -> int:
    try:
        for path in files:
            module = load_clause_file(path)
            cid, title = module.CLAUSE
            print(f"CLAUSE {cid} {title}", flush=True)
    except Failure as exc:
        return _die(str(exc))
    return 0


def report(n: int | str, status: str, text: str) -> None:
    line = " ".join(text.split())
    print(f"CLAUSE {n} {status} {line}", flush=True)


def _exit_status(failed: bool) -> int:
    leftover_units = [
        name for name in _list_foreman_units()
        if any(sid in name for sid in _UNITS)
    ]
    if leftover_units:
        print(f"foreman-proof: leftover units: {leftover_units}",
              file=sys.stderr)
        failed = True
    if not _KEEP_ROOT and _TEMP is not None and _TEMP.exists():
        print(f"foreman-proof: temp dir still present: {_TEMP}",
              file=sys.stderr)
        failed = True
    return 1 if failed else 0


def make_world_root(explicit: Path | None) -> Path:
    """World lives under <repo>/build/proof, never /tmp (decision 25).

    An explicit ``--root`` is owned by the caller and is not deleted.
    """
    global _KEEP_ROOT
    _KEEP_ROOT = explicit is not None
    if explicit is not None:
        root = Path(explicit)
        root.mkdir(parents=True, exist_ok=True)
        return root
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    root = REPO / "build" / "proof" / f"{stamp}-{os.getpid()}"
    root.mkdir(parents=True, exist_ok=False)
    return root


def _break_is(break_clause: object, cid: object) -> bool:
    """True when --break names this clause. Integers still match trial-frictions."""
    if break_clause in (None, "", 0, "0"):
        return False
    return str(break_clause) == str(cid)


def _run_one_clause(module, world) -> tuple[str, str]:
    """Run module.run(world). Returns (PASS|FAIL|SKIP, message)."""
    try:
        msg = module.run(world)
        return "PASS", str(msg)
    except Skip as exc:
        return "SKIP", str(exc)
    except Failure as exc:
        return "FAIL", str(exc)
    except subprocess.TimeoutExpired as exc:
        return "FAIL", f"timed out: {exc}"
    except Exception as exc:  # noqa: BLE001 - one line of evidence
        return "FAIL", f"{type(exc).__name__}: {exc}"


def _clause_break(module, path_name: str):
    """Return (line, apply, restore) or None when the clause has no BREAK."""
    br = getattr(module, "BREAK", None)
    if br is None:
        return None
    if not (isinstance(br, tuple) and len(br) == 3):
        raise Failure(f"{path_name} BREAK must be (line, apply, restore)")
    line, apply, restore = br
    if not isinstance(line, str) or not line.strip():
        raise Failure(f"{path_name} BREAK line must be a non-empty string")
    if not callable(apply) or not callable(restore):
        raise Failure(f"{path_name} BREAK apply and restore must be callable")
    return " ".join(line.split()), apply, restore


def _execute_break(cid, module, world, path_name: str) -> bool:
    """Apply a clause's own BREAK. Return True when the overall run failed."""
    try:
        br = _clause_break(module, path_name)
    except Failure as exc:
        print(f"foreman-proof: {exc}", file=sys.stderr)
        return True
    if br is None:
        report(cid, "FAIL", f"deliberately broken (clause {cid})")
        return True
    line, apply, restore = br
    status, msg = _run_one_clause(module, world)
    if status != "PASS":
        report(cid, status, msg)
        print(f"BREAK {cid} NOT-GREEN", flush=True)
        return True
    report(cid, "PASS", msg)
    try:
        apply(world)
    except Exception as exc:  # noqa: BLE001 - apply is the clause's job
        try:
            restore(world)
        except Exception:
            pass
        print(f"foreman-proof: BREAK {cid} apply failed: "
              f"{type(exc).__name__}: {exc}", file=sys.stderr)
        return True
    restore_error = None
    try:
        status2, _msg2 = _run_one_clause(module, world)
    finally:
        try:
            restore(world)
        except Exception as exc:  # noqa: BLE001 - must not hide the second run
            restore_error = exc
    if restore_error is not None:
        print(f"foreman-proof: BREAK {cid} restore failed: "
              f"{type(restore_error).__name__}: {restore_error}",
              file=sys.stderr)
        return True
    if status2 == "PASS":
        print(f"BREAK {cid} SURVIVED {line}", flush=True)
        return True
    print(f"BREAK {cid} RED {line}", flush=True)
    return False


def _maybe_record(cid: object, status: str, msg: str, *,
                  evidence: bool, front: str, live: bool) -> bool:
    """Record a CONFIRMED finish-line clause. True when recording failed."""
    if not evidence or status != "PASS":
        return False
    if not str(cid).startswith("f"):
        return False
    try:
        record_confirmed(front, cid, msg, live=live)
    except Failure as exc:
        print(f"foreman-proof: {exc}", file=sys.stderr)
        return True
    return False


def _run_loaded_clauses(files: list[Path], break_clause: object,
                        root: Path, *, evidence: bool = False,
                        evidence_front: str = "v5") -> int:
    global _REAL_GROK
    _REAL_GROK = shutil.which("grok", path=_ORIG_PATH)
    atexit.register(cleanup)
    failed = False
    try:
        world = build_world(root)
        for path in files:
            try:
                module = load_clause_file(path)
                cid, _title = module.CLAUSE
            except Failure as exc:
                print(f"foreman-proof: {exc}", file=sys.stderr)
                failed = True
                continue
            if _break_is(break_clause, cid):
                if _execute_break(cid, module, world, path.name):
                    failed = True
                continue
            status, msg = _run_one_clause(module, world)
            report(cid, status, msg)
            if status == "FAIL":
                failed = True
            if _maybe_record(cid, status, msg, evidence=evidence,
                             front=evidence_front, live=False):
                failed = True
    finally:
        cleanup()
    return _exit_status(failed)


def _run_live_clauses(files: list[Path], args: argparse.Namespace) -> int:
    """Read-only finish-line checks against the live installation."""
    print("live: read-only", flush=True)
    if args.break_clause:
        return _die("--live is read-only; --break writes")
    front = (args.live_front or "v5").strip() or "v5"
    shown = run_live_foreman(["front", "show", front])
    if shown.returncode != 0:
        err = (shown.stderr or shown.stdout or "").strip()
        print(f"unknown front {front}", flush=True)
        if err:
            print(err, file=sys.stderr)
        return 1
    failed = False
    ran = 0
    for path in files:
        try:
            module = load_clause_file(path)
            cid, _title = module.CLAUSE
        except Failure as exc:
            print(f"foreman-proof: {exc}", file=sys.stderr)
            failed = True
            continue
        run_live = getattr(module, "run_live", None)
        if not callable(run_live):
            continue
        ran += 1
        try:
            msg = run_live(front)
            report(cid, "PASS", str(msg))
            if _maybe_record(cid, "PASS", str(msg),
                             evidence=args.evidence,
                             front=front, live=True):
                failed = True
        except Skip as exc:
            report(cid, "SKIP", str(exc))
        except Failure as exc:
            report(cid, "FAIL", str(exc))
            failed = True
        except subprocess.TimeoutExpired as exc:
            report(cid, "FAIL", f"timed out: {exc}")
            failed = True
        except Exception as exc:  # noqa: BLE001 - one line of evidence
            report(cid, "FAIL", f"{type(exc).__name__}: {exc}")
            failed = True
    if ran == 0:
        return _die("live: read-only; no finish-line clause to run")
    return 1 if failed else 0


def _main_v5(args: argparse.Namespace) -> int:
    clauses_dir = args.clauses.resolve() if args.clauses is not None else None
    if clauses_dir is not None and not clauses_dir.is_dir():
        return _die(f"no such clauses directory: {clauses_dir}")
    files = discover_v5_files(args.milestone, directory=clauses_dir)
    source_name = str(clauses_dir) if clauses_dir is not None else V5_DIR_NAME
    if args.milestone is not None and not files:
        return _die(
            f"unknown milestone {args.milestone}: no clause files in {source_name}")
    if args.list_only:
        return list_v5_clauses(files)
    if args.live:
        return _run_live_clauses(files, args)
    return _run_loaded_clauses(
        files, args.break_clause, make_world_root(args.root),
        evidence=args.evidence,
        evidence_front=(args.live_front or "v5").strip() or "v5")


def main(argv: list[str] | None = None) -> int:
    global _REAL_GROK
    parser = argparse.ArgumentParser(
        description="Run a front's proof clauses on an isolated world.")
    parser.add_argument("front", help="front name (trial-frictions or v5)")
    parser.add_argument(
        "--break", dest="break_clause", default=None,
        help="run this clause's BREAK (apply/restore); a clause with no BREAK "
             "is still deliberately failed (integer still works for trial-frictions)")
    parser.add_argument(
        "--milestone", type=int, default=None, metavar="N",
        help="run only the v5 clause files of milestone N")
    parser.add_argument(
        "--list", action="store_true", dest="list_only",
        help="print CLAUSE id title per v5 file and exit without a world")
    parser.add_argument(
        "--clauses", type=Path, default=None, metavar="DIR",
        help="load v5 clause files from DIR instead of proof/v5")
    parser.add_argument(
        "--root", type=Path, default=None,
        help="world root (default: <repo>/build/proof/<utc timestamp>-<pid>)")
    parser.add_argument(
        "--live", action="store_true",
        help="check finish-line clauses against the live installation "
             "(read-only; never sets FOREMAN_STATE)")
    parser.add_argument(
        "--front", dest="live_front", default="v5",
        help="live front to read with --live (default v5)")
    parser.add_argument(
        "--evidence", action="store_true",
        help="record each CONFIRMED finish-line clause through "
             "foreman evidence --on <front>")
    args = parser.parse_args(argv)

    global _CALLER_SESSION
    _CALLER_SESSION = os.environ.get(SESSION_ENV)

    # Isolated-world runs never inherit the caller's world. --live reads
    # the installation through the caller's environment and must not
    # clear FOREMAN_STATE. --evidence keeps the caller's session so the
    # evidence line is by that session.
    if not args.live:
        for name in (STATE_ENV, CONFIG_ENV):
            os.environ.pop(name, None)
        if not args.evidence:
            os.environ.pop(SESSION_ENV, None)

    if args.front == "v5":
        return _main_v5(args)
    if args.live:
        return _die("--live applies to front v5")
    if args.front != FRONT:
        return _die(
            f"unknown front {args.front!r}; only {FRONT} and v5 are implemented")
    if args.list_only or args.milestone is not None or args.clauses is not None:
        return _die("--list, --milestone and --clauses apply to front v5")

    _REAL_GROK = shutil.which("grok", path=_ORIG_PATH)

    root = make_world_root(args.root)
    atexit.register(cleanup)
    failed = False
    try:
        world = build_world(root)
        for n, fn in CLAUSES:
            try:
                if n == 12:
                    msg = fn(world, break_it=_break_is(args.break_clause, 12))
                elif _break_is(args.break_clause, n):
                    raise Failure(f"deliberately broken (clause {n})")
                else:
                    msg = fn(world)
                report(n, "PASS", msg)
            except Skip as exc:
                report(n, "SKIP", str(exc))
            except Failure as exc:
                report(n, "FAIL", str(exc))
                failed = True
            except subprocess.TimeoutExpired as exc:
                report(n, "FAIL", f"timed out: {exc}")
                failed = True
            except Exception as exc:  # noqa: BLE001 - one line of evidence
                report(n, "FAIL", f"{type(exc).__name__}: {exc}")
                failed = True
    finally:
        cleanup()

    return _exit_status(failed)


if __name__ == "__main__":
    sys.exit(main())
